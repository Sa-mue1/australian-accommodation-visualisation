{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 760,
  "height": 360,
  "padding": {
    "left": 5,
    "right": 90,
    "top": 5,
    "bottom": 5
  },
  "title": {
    "text": [
      "Sydney regained first place after",
      "Melbourne briefly led in 2023"
    ],
    "subtitle": [
      "Major destinations ranked by domestic visitor nights",
      "Hotels and similar accommodation, 2019–2024"
    ],
    "anchor": "start",
    "fontSize": 17,
    "fontWeight": "bold",
    "subtitleFontSize": 12,
    "subtitleFontWeight": "normal",
    "subtitlePadding": 8,
    "offset": 12
  },
  "data": {
    "url": "data/domestic_accommodation_types.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "value": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.accommodation_type === 'Hotels and similar' && datum.area_type === 'capital_or_primary_region' && datum.measure === 'visitor_nights_thousand' && datum.data_status === 'published' && datum.year >= 2019 && datum.year <= 2024"
    },
    {
      "calculate": "datum.geography === 'Experience Perth' ? 'Perth' : datum.geography === 'Hobart and the South' ? 'Hobart' : datum.geography === 'ACT' ? 'Canberra' : datum.geography",
      "as": "destination"
    },
    {
      "calculate": "datum.value / 1000",
      "as": "visitor_nights_million"
    },
    {
      "window": [
        {
          "op": "rank",
          "as": "rank"
        }
      ],
      "sort": [
        {
          "field": "value",
          "order": "descending"
        }
      ],
      "groupby": [
        "year"
      ]
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.5,
        "opacity": 0.9
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "sort": "ascending",
          "axis": {
            "title": "Year",
            "labelAngle": 0,
            "labelFontSize": 12,
            "titleFontSize": 13,
            "titlePadding": 12,
            "grid": false,
            "tickSize": 4
          }
        },
        "y": {
          "field": "rank",
          "type": "quantitative",
          "scale": {
            "domain": [
              0.5,
              8.6
            ],
            "reverse": true
          },
          "axis": {
            "title": "Rank by hotel visitor nights (1 = highest)",
            "values": [
              1,
              2,
              3,
              4,
              5,
              6,
              7,
              8
            ],
            "labelFontSize": 12,
            "titleFontSize": 13,
            "titlePadding": 12,
            "grid": true,
            "gridColor": "#E5E7EB",
            "gridOpacity": 0.8,
            "domain": false,
            "tickSize": 0
          }
        },
        "detail": {
          "field": "destination"
        },
        "order": {
          "field": "year",
          "type": "ordinal"
        },
        "color": {
          "condition": [
            {
              "test": "datum.destination === 'Sydney'",
              "value": "#0072B2"
            },
            {
              "test": "datum.destination === 'Melbourne'",
              "value": "#D55E00"
            },
            {
              "test": "datum.destination === 'Brisbane'",
              "value": "#009E73"
            }
          ],
          "value": "#9CA3AF"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 72,
        "stroke": "white",
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "sort": "ascending"
        },
        "y": {
          "field": "rank",
          "type": "quantitative",
          "scale": {
            "domain": [
              0.5,
              8.6
            ],
            "reverse": true
          }
        },
        "color": {
          "condition": [
            {
              "test": "datum.destination === 'Sydney'",
              "value": "#0072B2"
            },
            {
              "test": "datum.destination === 'Melbourne'",
              "value": "#D55E00"
            },
            {
              "test": "datum.destination === 'Brisbane'",
              "value": "#009E73"
            }
          ],
          "value": "#9CA3AF"
          
        },
        "tooltip": [
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "destination",
            "type": "nominal",
            "title": "Destination"
          },
          {
            "field": "rank",
            "type": "quantitative",
            "title": "Rank",
            "format": ".0f"
          },
          {
            "field": "visitor_nights_million",
            "type": "quantitative",
            "title": "Hotel visitor nights (millions)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === 2024"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 10,
        "fontSize": 12,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "sort": "ascending"
        },
        "y": {
          "field": "rank",
          "type": "quantitative",
          "scale": {
            "domain": [
              0.5,
              8.6
            ],
            "reverse": true
          }
        },
        "text": {
          "field": "destination"
        },
        "color": {
          "condition": [
            {
              "test": "datum.destination === 'Sydney'",
              "value": "#0072B2"
            },
            {
              "test": "datum.destination === 'Melbourne'",
              "value": "#D55E00"
            },
            {
              "test": "datum.destination === 'Brisbane'",
              "value": "#007A5E"
            }
          ],
          "value": "#5F6873"
        }
      }
    }
  ],
  "config": {
    "background": "white",
    "font": "Arial",
    "view": {
      "stroke": null
    }
  }
}