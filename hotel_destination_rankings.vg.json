{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 300,
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  },
  "padding": {
    "left": 5,
    "right": 5,
    "top": 5,
    "bottom": 5
  },
  "title": {
    "text": [
      "Sydney regained first place after",
      "Melbourne briefly led in 2023"
    ],
    "subtitle": [
      "Major destinations ranked by domestic visitor nights",
      "Hotels and similar accommodation, 2019–2024"
    ],
    "anchor": "start",
    "fontSize": 17,
    "fontWeight": "bold",
    "subtitleFontSize": 12,
    "subtitleFontWeight": "normal",
    "subtitlePadding": 7,
    "offset": 8
  },
  "data": {
    "url": "data/domestic_accommodation_types.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "value": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.accommodation_type === 'Hotels and similar' && datum.area_type === 'capital_or_primary_region' && datum.measure === 'visitor_nights_thousand' && datum.data_status === 'published' && datum.year >= 2019 && datum.year <= 2024"
    },
    {
      "calculate": "datum.geography === 'Experience Perth' ? 'Perth' : datum.geography === 'Hobart and the South' ? 'Hobart' : datum.geography === 'ACT' ? 'Canberra' : datum.geography",
      "as": "destination"
    },
    {
      "calculate": "datum.value / 1000",
      "as": "visitor_nights_million"
    },
    {
      "window": [
        {
          "op": "rank",
          "as": "rank"
        }
      ],
      "sort": [
        {
          "field": "value",
          "order": "descending"
        }
      ],
      "groupby": ["year"]
    },
    {
      "calculate": "datum.destination === 'Sydney' || datum.destination === 'Melbourne' || datum.destination === 'Brisbane' ? datum.destination : 'Other destinations'",
      "as": "destination_group"
    },
    {
      "calculate": "datum.year === 2019 ? datum.value : null",
      "as": "baseline_value"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "baseline_value",
          "as": "baseline_2019"
        }
      ],
      "groupby": ["destination"]
    },
    {
      "calculate": "datum.value / datum.baseline_2019 - 1",
      "as": "change_since_2019"
    }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "scale": {
        "domain": [2018.75, 2024.85],
        "nice": false,
        "zero": false
      },
      "axis": {
        "title": "Year",
        "values": [2019, 2020, 2021, 2022, 2023, 2024],
        "format": "d",
        "labelAngle": 0,
        "labelFontSize": 12,
        "labelFontWeight": "bold",
        "labelPadding": 6,
        "titleFontSize": 13,
        "titleFontWeight": "bold",
        "titlePadding": 8,
        "grid": false,
        "tickSize": 4,
        "domain": false
      }
    },
    "y": {
      "field": "rank",
      "type": "quantitative",
      "scale": {
        "domain": [0.5, 8.6],
        "reverse": true,
        "nice": false,
        "zero": false
      },
      "axis": {
        "title": "Hotel-night rank (1 = highest)",
        "values": [1, 2, 3, 4, 5, 6, 7, 8],
        "format": "d",
        "labelFontSize": 12,
        "labelFontWeight": "bold",
        "titleFontSize": 13,
        "titleFontWeight": "bold",
        "titlePadding": 12,
        "grid": true,
        "gridColor": "#E5E7EB",
        "gridOpacity": 0.8,
        "domain": false,
        "tickSize": 0
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "color": "#334155",
        "strokeWidth": 3
      },
      "encoding": {
        "detail": {
          "field": "destination",
          "type": "nominal"
        },
        "order": {
          "field": "year",
          "type": "quantitative"
        },
        "strokeDash": {
          "field": "destination_group",
          "type": "nominal",
          "scale": {
            "domain": [
              "Sydney",
              "Melbourne",
              "Brisbane",
              "Other destinations"
            ],
            "range": [
              [1, 0],
              [8, 4],
              [2, 3],
              [5, 2, 1, 2]
            ]
          },
          "legend": {
            "title": "Destination line pattern",
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 2,
            "labelFontSize": 11,
            "labelLimit": 170,
            "titleFontSize": 12,
            "titleFontWeight": "bold",
            "titlePadding": 5,
            "rowPadding": 5,
            "columnPadding": 16,
            "symbolType": "stroke",
            "symbolStrokeWidth": 3,
            "symbolSize": 240,
            "offset": 8
          }
        },
        "opacity": {
          "condition": {
            "param": "destination_focus",
            "value": 1
          },
          "value": 0.15
        },
        "strokeWidth": {
          "condition": {
            "param": "destination_focus",
            "empty": false,
            "value": 4.2
          },
          "value": 3
        }
      }
    },
    {
      "params": [
        {
          "name": "destination_focus",
          "select": {
            "type": "point",
            "fields": ["destination"],
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout",
            "toggle": false
          }
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 90,
        "color": "#334155",
        "stroke": "white",
        "strokeWidth": 1.2
      },
      "encoding": {
        "opacity": {
          "condition": {
            "param": "destination_focus",
            "value": 1
          },
          "value": 0.15
        },
        "tooltip": [
          {
            "field": "year",
            "type": "quantitative",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "destination",
            "type": "nominal",
            "title": "Destination"
          },
          {
            "field": "rank",
            "type": "quantitative",
            "title": "Rank",
            "format": ".0f"
          },
          {
            "field": "visitor_nights_million",
            "type": "quantitative",
            "title": "Hotel visitor nights (millions)",
            "format": ".2f"
          },
          {
            "field": "change_since_2019",
            "type": "quantitative",
            "title": "Change since 2019",
            "format": "+.1%"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === 2024"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 8,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#334155"
      },
      "encoding": {
        "text": {
          "field": "destination"
        },
        "opacity": {
          "condition": {
            "param": "destination_focus",
            "value": 1
          },
          "value": 0.3
        }
      }
    }
  ],
  "config": {
    "background": "white",
    "font": "Arial",
    "view": {
      "stroke": null
    }
  }
}