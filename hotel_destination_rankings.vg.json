{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 650,
  "height": 430,
  "title": {
    "text": "Sydney and Melbourne exchanged the leading hotel rank",
    "subtitle": [
      "Major destinations ranked by domestic visitor nights",
      "Hotels and similar accommodation, 2019–2024"
    ],
    "anchor": "start",
    "fontSize": 18,
    "subtitleFontSize": 12,
    "subtitleColor": "#555555"
  },
  "data": {
    "url": "data/domestic_accommodation_types.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "value": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.area_type == 'capital_or_primary_region'"
    },
    {
      "filter": "datum.accommodation_type == 'Hotels and similar'"
    },
    {
      "filter": "datum.measure == 'visitor_nights_thousand'"
    },
    {
      "filter": "datum.data_status == 'published'"
    },
    {
      "filter": "isValid(datum.value) && datum.value > 0"
    },
    {
      "calculate": "datum.geography == 'Experience Perth' ? 'Perth' : datum.geography == 'Hobart and the South' ? 'Hobart' : datum.geography == 'ACT' ? 'Canberra' : datum.geography",
      "as": "destination"
    },
    {
      "calculate": "datum.value / 1000",
      "as": "visitor_nights_million"
    },
    {
      "window": [
        {
          "op": "rank",
          "as": "rank"
        }
      ],
      "sort": [
        {
          "field": "value",
          "order": "descending"
        }
      ],
      "groupby": [
        "year"
      ]
    }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": "Year",
      "sort": "ascending",
      "scale": {
        "padding": 0.15
      },
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 11,
        "titleFontSize": 12,
        "titlePadding": 10,
        "grid": true,
        "gridColor": "#ededed"
      }
    },
    "y": {
      "field": "rank",
      "type": "quantitative",
      "title": "Rank by hotel visitor nights (1 = highest)",
      "scale": {
        "domain": [0.5, 8.5],
        "reverse": true
      },
      "axis": {
        "values": [1, 2, 3, 4, 5, 6, 7, 8],
        "labelFontSize": 11,
        "titleFontSize": 12,
        "titlePadding": 12,
        "grid": true,
        "gridColor": "#ededed"
      }
    },
    "color": {
      "field": "destination",
      "type": "nominal",
      "title": "Destination",
      "scale": {
        "domain": [
          "Sydney",
          "Melbourne",
          "Brisbane",
          "Perth",
          "Adelaide",
          "Canberra",
          "Hobart",
          "Darwin"
        ],
        "scheme": "tableau10"
      },
      "legend": null
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3
      },
      "encoding": {
        "detail": {
          "field": "destination",
          "type": "nominal"
        },
        "order": {
          "field": "year",
          "type": "ordinal"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 90,
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "tooltip": [
          {
            "field": "destination",
            "type": "nominal",
            "title": "Destination"
          },
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "rank",
            "type": "quantitative",
            "title": "Rank",
            "format": ".0f"
          },
          {
            "field": "visitor_nights_million",
            "type": "quantitative",
            "title": "Hotel visitor nights (millions)",
            "format": ",.1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2024"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 10,
        "fontSize": 11,
        "fontWeight": "bold"
      },
      "encoding": {
        "text": {
          "field": "destination"
        }
      }
    }
  ],
  "config": {
    "background": "white",
    "font": "Arial",
    "view": {
      "stroke": null
    }
  }
}