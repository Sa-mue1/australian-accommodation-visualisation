{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 380,
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  },
  "padding": {
    "left": 5,
    "right": 5,
    "top": 5,
    "bottom": 5
  },
  "title": {
    "text": [
      "Rented accommodation gained;",
      "stays with friends declined"
    ],
    "subtitle": [
      "International visitor nights by accommodation type",
      "Years ending June 2025 and June 2026"
    ],
    "anchor": "start",
    "fontSize": 18,
    "fontWeight": "bold",
    "lineHeight": 22,
    "subtitleFontSize": 12,
    "subtitleColor": "#5F6368",
    "subtitleLineHeight": 16,
    "subtitlePadding": 7,
    "offset": 14
  },
  "data": {
    "url": "data/international_accommodation_types.csv",
    "format": {
      "type": "csv",
      "parse": {
        "nights_thousand": "number",
        "share_percent": "number",
        "percent_change_from_2025": "number"
      }
    }
  },
  "transform": [
    {
      "filter": {
        "field": "period",
        "oneOf": [
          "Year ending June 2025",
          "Year ending June 2026"
        ]
      }
    },
    {
      "filter": {
        "field": "accommodation_type",
        "oneOf": [
          "Rented house/apartment/flat or unit",
          "Friends or relatives property",
          "Hotel/resort/motel or motor Inn",
          "Other Private Accommodation",
          "Backpacker or hostel",
          "Other Accommodation",
          "Own property"
        ]
      }
    },
    {
      "calculate": "datum.nights_thousand / 1000",
      "as": "nights_million"
    },
    {
      "calculate": "datum.period === 'Year ending June 2025' ? '2025' : '2026'",
      "as": "year_label"
    },
    {
      "calculate": "datum.accommodation_type === 'Rented house/apartment/flat or unit' ? 'Rented home' : datum.accommodation_type === 'Friends or relatives property' ? 'Friends/relatives' : datum.accommodation_type === 'Hotel/resort/motel or motor Inn' ? 'Hotel/resort/motel' : datum.accommodation_type === 'Other Private Accommodation' ? 'Other private' : datum.accommodation_type === 'Backpacker or hostel' ? 'Backpacker/hostel' : datum.accommodation_type === 'Other Accommodation' ? 'Other' : 'Own property'",
      "as": "accommodation_label"
    },
    {
      "calculate": "format(datum.nights_million, '.1f') + 'm'",
      "as": "value_label"
    },
    {
      "calculate": "datum.period === 'Year ending June 2026' ? format(datum.percent_change_from_2025, '+.1f') + '%' : 'Baseline year'",
      "as": "change_tooltip"
    },
    {
      "calculate": "datum.year_label === '2025' ? datum.nights_million : null",
      "as": "value_2025"
    },
    {
      "calculate": "datum.year_label === '2026' ? datum.nights_million : null",
      "as": "value_2026"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "value_2025",
          "as": "type_value_2025"
        },
        {
          "op": "max",
          "field": "value_2026",
          "as": "type_value_2026"
        }
      ],
      "groupby": ["accommodation_type"]
    },
    {
      "calculate": "datum.type_value_2026 >= datum.type_value_2025 ? 'increase' : 'decrease'",
      "as": "change_direction"
    }
  ],
  "encoding": {
    "x": {
      "field": "nights_million",
      "type": "quantitative",
      "title": "Visitor nights (millions)",
      "scale": {
        "domain": [-30, 170],
        "nice": false,
        "zero": false
      },
      "axis": {
        "values": [0, 40, 80, 120, 160],
        "format": ".0f",
        "grid": true,
        "gridColor": "#E5E7EB",
        "labelFontSize": 12,
        "labelPadding": 7,
        "titleFontSize": 13,
        "titleFontWeight": "bold",
        "titlePadding": 12,
        "domainColor": "#C9D0D6",
        "tickColor": "#C9D0D6"
      }
    },
    "y": {
      "field": "accommodation_label",
      "type": "nominal",
      "title": null,
      "sort": [
        "Rented home",
        "Friends/relatives",
        "Hotel/resort/motel",
        "Other private",
        "Backpacker/hostel",
        "Other",
        "Own property"
      ],
      "axis": {
        "domain": false,
        "ticks": false,
        "labelFontSize": 12,
        "labelFontWeight": "bold",
        "labelLimit": 140,
        "labelPadding": 10
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "stroke": "#B9BEC5",
        "strokeWidth": 3.5
      },
      "encoding": {
        "detail": {
          "field": "accommodation_label",
          "type": "nominal"
        },
        "order": {
          "field": "year_label",
          "type": "ordinal"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 110,
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "color": {
          "field": "year_label",
          "type": "ordinal",
          "title": "Year ending June",
          "scale": {
            "domain": ["2025", "2026"],
            "range": ["#999999", "#0072B2"]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 2,
            "titleOrient": "top",
            "titleAnchor": "start",
            "titlePadding": 5,
            "labelFontSize": 12,
            "titleFontSize": 12,
            "symbolSize": 90,
            "columnPadding": 20,
            "offset": 12
          }
        },
        "tooltip": [
          {
            "field": "accommodation_type",
            "type": "nominal",
            "title": "Accommodation type"
          },
          {
            "field": "year_label",
            "type": "ordinal",
            "title": "Year ending June"
          },
          {
            "field": "nights_million",
            "type": "quantitative",
            "title": "Visitor nights (millions)",
            "format": ",.1f"
          },
          {
            "field": "share_percent",
            "type": "quantitative",
            "title": "Share of visitor nights (%)",
            "format": ".1f"
          },
          {
            "field": "change_tooltip",
            "type": "nominal",
            "title": "Change from 2025"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": {
          "expr": "(datum.year_label === '2025' && datum.change_direction === 'increase') || (datum.year_label === '2026' && datum.change_direction === 'decrease') ? 'right' : 'left'"
        },
        "baseline": "middle",
        "dx": {
          "expr": "(datum.year_label === '2025' && datum.change_direction === 'increase') || (datum.year_label === '2026' && datum.change_direction === 'decrease') ? -10 : 10"
        },
        "fontSize": 11,
        "fontWeight": "bold",
        "color": {
          "expr": "datum.year_label === '2026' ? '#0072B2' : '#5F6368'"
        }
      },
      "encoding": {
        "text": {
          "field": "value_label"
        }
      }
    }
  ],
  "config": {
    "background": "white",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#374151",
      "titleColor": "#202124"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "bold",
      "labelColor": "#374151"
    }
  }
}