{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 330,
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  },
  "padding": {
    "left": 5,
    "right": 5,
    "top": 5,
    "bottom": 47
  },
  "params": [
    {
      "name": "label_gutter",
      "value": 120
    }
  ],
  "title": {
    "text": [
      "International accommodation demand",
      "scross different types of stays"
    ],
    "subtitle": [
      "International visitor nights in millions, by accommodation type",
      "Years ending June 2025 and June 2026"
    ],
    "anchor": "start",
    "fontSize": 17,
    "fontWeight": "bold",
    "lineHeight": 21,
    "subtitleFontSize": 12,
    "subtitleColor": "#5F6368",
    "subtitleLineHeight": 15,
    "subtitlePadding": 7,
    "offset": 10
  },
  "description": "International visitor nights by accommodation type in the years ending June 2025 and June 2026. Each pair of points uses the same linear scale.",
  "data": {
    "url": "data/international_accommodation_types.csv",
    "format": {
      "type": "csv",
      "parse": {
        "nights_thousand": "number",
        "share_percent": "number",
        "percent_change_from_2025": "number"
      }
    }
  },
  "transform": [
    {
      "filter": {
        "field": "period",
        "oneOf": [
          "Year ending June 2025",
          "Year ending June 2026"
        ]
      }
    },
    {
      "filter": {
        "field": "accommodation_type",
        "oneOf": [
          "Rented house/apartment/flat or unit",
          "Friends or relatives property",
          "Hotel/resort/motel or motor Inn",
          "Other Private Accommodation",
          "Backpacker or hostel",
          "Other Accommodation",
          "Own property"
        ]
      }
    },
    {
      "calculate": "datum.nights_thousand / 1000",
      "as": "nights_million"
    },
    {
      "calculate": "datum.period === 'Year ending June 2025' ? '2025' : '2026'",
      "as": "year_label"
    },
    {
      "calculate": "datum.accommodation_type === 'Rented house/apartment/flat or unit' ? 'Rented homes' : datum.accommodation_type === 'Friends or relatives property' ? 'Friends or relatives' : datum.accommodation_type === 'Hotel/resort/motel or motor Inn' ? 'Hotels and similar' : datum.accommodation_type === 'Other Private Accommodation' ? 'Other private' : datum.accommodation_type === 'Backpacker or hostel' ? 'Hostels' : datum.accommodation_type === 'Other Accommodation' ? 'Other stays' : 'Own property'",
      "as": "accommodation_label"
    },
    {
      "calculate": "format(datum.nights_million, '.1f')",
      "as": "value_label"
    },
    {
      "calculate": "datum.period === 'Year ending June 2026' ? format(datum.percent_change_from_2025, '+.1f') + '%' : 'Baseline year'",
      "as": "change_tooltip"
    },
    {
      "calculate": "datum.year_label === '2025' ? datum.nights_million : null",
      "as": "value_2025"
    },
    {
      "calculate": "datum.year_label === '2026' ? datum.nights_million : null",
      "as": "value_2026"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "value_2025",
          "as": "type_value_2025"
        },
        {
          "op": "max",
          "field": "value_2026",
          "as": "type_value_2026"
        }
      ],
      "groupby": ["accommodation_type"]
    },
    {
      "calculate": "datum.type_value_2026 >= datum.type_value_2025 ? 'increase' : 'decrease'",
      "as": "change_direction"
    },
    {
      "calculate": "datum.share_percent / 100",
      "as": "share_fraction"
    }
  ],
  "encoding": {
    "x": {
      "field": "nights_million",
      "type": "quantitative",
      "title": "Visitor nights (millions)",
      "scale": {
        "domain": [-10, 170],
        "nice": false,
        "zero": false
      },
      "axis": {
        "values": [0, 40, 80, 120, 160],
        "format": ".0f",
        "grid": true,
        "gridColor": "#E5E7EB",
        "labelFontSize": 12,
        "labelPadding": 7,
        "titleFontSize": 13,
        "titleFontWeight": "bold",
        "titlePadding": 10,
        "domainColor": "#C9D0D6",
        "tickColor": "#C9D0D6"
      }
    },
    "y": {
      "field": "accommodation_label",
      "type": "nominal",
      "title": null,
      "sort": [
        "Rented homes",
        "Friends or relatives",
        "Hotels and similar",
        "Other private",
        "Hostels",
        "Other stays",
        "Own property"
      ],
      "axis": {
        "domain": false,
        "ticks": false,
        "labelFontSize": 12,
        "labelFontWeight": "normal",
        "labelLineHeight": 14,
        "labelLimit": 114,
        "labelPadding": 8,
        "labelExpr": "datum.label === 'Friends or relatives' ? ['Friends or', 'relatives'] : datum.label",
        "labelOffset": {
          "expr": "datum.value === 'Friends or relatives' ? -7 : 0"
        },
        "minExtent": {
          "expr": "label_gutter"
        },
        "maxExtent": {
          "expr": "label_gutter"
        }
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "stroke": "#B9BEC5",
        "strokeWidth": 3
      },
      "encoding": {
        "detail": {
          "field": "accommodation_label",
          "type": "nominal"
        },
        "order": {
          "field": "year_label",
          "type": "ordinal"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 120,
        "stroke": "white",
        "strokeWidth": 1,
        "opacity": 1
      },
      "encoding": {
        "color": {
          "field": "year_label",
          "type": "nominal",
          "title": "Year ending June",
          "scale": {
            "domain": ["2025", "2026"],
            "range": ["#AEB5BF", "#6F2945"]
          },
          "legend": {
            "orient": "none",
            "legendX": {
              "expr": "-label_gutter"
            },
            "legendY": {
              "expr": "height + 60"
            },
            "direction": "horizontal",
            "columns": 2,
            "titleOrient": "top",
            "titleAnchor": "start",
            "titleAlign": "left",
            "titlePadding": 5,
            "labelFontSize": 12,
            "titleFontSize": 12,
            "symbolSize": 100,
            "columnPadding": 20
          }
        },
        "tooltip": [
          {
            "field": "accommodation_type",
            "type": "nominal",
            "title": "Accommodation type"
          },
          {
            "field": "year_label",
            "type": "ordinal",
            "title": "Year ending June"
          },
          {
            "field": "nights_million",
            "type": "quantitative",
            "title": "Visitor nights",
            "format": ",.1f"
          },
          {
            "field": "share_fraction",
            "type": "quantitative",
            "title": "Share of visitor nights",
            "format": ".1%"
          },
          {
            "field": "change_tooltip",
            "type": "nominal",
            "title": "Change from 2025"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": {
          "expr": "(datum.year_label === '2025' && datum.change_direction === 'increase') || (datum.year_label === '2026' && datum.change_direction === 'decrease') ? 'right' : 'left'"
        },
        "baseline": "middle",
        "dx": {
          "expr": "(datum.year_label === '2025' && datum.change_direction === 'increase') || (datum.year_label === '2026' && datum.change_direction === 'decrease') ? -9 : 9"
        },
        "fontSize": 12,
        "fontWeight": "bold",
        "color": {
          "expr": "datum.year_label === '2026' ? '#6F2945' : '#626B77'"
        }
      },
      "encoding": {
        "text": {
          "field": "value_label"
        },
        "tooltip": [
          {
            "field": "accommodation_type",
            "type": "nominal",
            "title": "Accommodation type"
          },
          {
            "field": "year_label",
            "type": "ordinal",
            "title": "Year ending June"
          },
          {
            "field": "nights_million",
            "type": "quantitative",
            "title": "Visitor nights",
            "format": ",.1f"
          },
          {
            "field": "share_fraction",
            "type": "quantitative",
            "title": "Share of visitor nights",
            "format": ".1%"
          },
          {
            "field": "change_tooltip",
            "type": "nominal",
            "title": "Change from 2025"
          }
        ]
      }
    }
  ],
  "config": {
    "background": "white",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#374151",
      "titleColor": "#202124"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "bold",
      "labelColor": "#374151"
    }
  }
}