{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Domestic accommodation recovered unevenly",
    "subtitle": [
      "Australian visitor nights index, 2019 = 100",
      "National Visitor Survey, 2019–2024"
    ],
    "anchor": "start",
    "fontSize": 18,
    "subtitleFontSize": 12,
    "offset": 16
  },
  "data": {
    "url": "data/domestic_accommodation_types.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "value": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.geography === 'Australia'"
    },
    {
      "filter": "datum.measure === 'visitor_nights_thousand'"
    },
    {
      "filter": "datum.data_status === 'published'"
    },
    {
      "filter": {
        "field": "accommodation_type",
        "oneOf": [
          "Hotels and similar",
          "Rented accommodation",
          "Caravan park or commercial camping",
          "Friends or relatives' property"
        ]
      }
    },
    {
      "calculate": "datum.year === 2019 ? datum.value : null",
      "as": "baseline_2019"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "baseline_2019",
          "as": "value_2019"
        }
      ],
      "groupby": ["accommodation_type"]
    },
    {
      "calculate": "datum.value / datum.value_2019 * 100",
      "as": "recovery_index"
    }
  ],
  "facet": {
    "field": "accommodation_type",
    "type": "nominal",
    "header": {
      "title": null,
      "labelFontSize": 13,
      "labelFontWeight": "bold",
      "labelLimit": 300
    }
  },
  "columns": 2,
  "spacing": 28,
  "spec": {
    "width": 300,
    "height": 170,
    "layer": [
      {
        "mark": {
          "type": "rule",
          "color": "#7A7A7A",
          "strokeDash": [5, 4],
          "opacity": 0.7
        },
        "encoding": {
          "y": {
            "datum": 100
          }
        }
      },
      {
        "mark": {
          "type": "rule",
          "color": "#C65D4B",
          "strokeDash": [3, 3],
          "opacity": 0.4
        },
        "encoding": {
          "x": {
            "datum": 2020,
            "type": "ordinal"
          }
        }
      },
      {
        "mark": {
          "type": "line",
          "color": "#176B87",
          "strokeWidth": 2.5,
          "point": {
            "filled": true,
            "size": 60
          }
        },
        "encoding": {
          "x": {
            "field": "year",
            "type": "ordinal",
            "axis": {
              "title": null,
              "labelAngle": 0
            }
          },
          "y": {
            "field": "recovery_index",
            "type": "quantitative",
            "scale": {
              "domain": [40, 120]
            },
            "axis": {
              "title": "Visitor nights index",
              "tickCount": 5
            }
          },
          "tooltip": [
            {
              "field": "accommodation_type",
              "type": "nominal",
              "title": "Accommodation"
            },
            {
              "field": "year",
              "type": "ordinal",
              "title": "Year"
            },
            {
              "field": "value",
              "type": "quantitative",
              "title": "Visitor nights ('000)",
              "format": ",.0f"
            },
            {
              "field": "recovery_index",
              "type": "quantitative",
              "title": "2019 index",
              "format": ".1f"
            }
          ]
        }
      }
    ]
  },
  "resolve": {
    "scale": {
      "y": "shared"
    }
  },
  "config": {
    "font": "Arial",
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "gridColor": "#E5E7EB",
      "domain": false
    },
    "view": {
      "stroke": null
    }
  }
}