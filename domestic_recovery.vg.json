{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Domestic accommodation recovery",
    "subtitle": [
      "Domestic visitor nights, 2019–2024; 2019 = 100",
      "Collection changed in 2025; the series are not joined."
    ],
    "anchor": "start",
    "fontSize": 18,
    "fontWeight": "bold",
    "subtitleFontSize": 12,
    "subtitlePadding": 7,
    "offset": 8
  },
  "data": {
    "url": "data/domestic_accommodation_types.csv",
    "format": {
      "type": "csv",
      "parse": {"year": "number", "value": "number"}
    }
  },
  "transform": [
    {
      "filter": "datum.geography === 'Australia' && datum.area_type === 'australia_total' && datum.measure === 'visitor_nights_thousand' && datum.data_status === 'published' && datum.year >= 2019 && datum.year <= 2024"
    },
    {
      "filter": "indexof(['Hotels and similar', 'Rented accommodation', 'Caravan park or commercial camping', \"Friends or relatives' property\"], datum.accommodation_type) >= 0"
    },
    {
      "calculate": "datum.accommodation_type === 'Caravan park or commercial camping' ? 'Caravan / camping' : datum.accommodation_type === \"Friends or relatives' property\" ? 'Friends or relatives' : datum.accommodation_type",
      "as": "category"
    },
    {
      "calculate": "datum.year === 2019 ? datum.value : null",
      "as": "baseline_value"
    },
    {
      "joinaggregate": [
        {"op": "max", "field": "baseline_value", "as": "baseline_2019"}
      ],
      "groupby": ["category"]
    },
    {
      "calculate": "datum.value / datum.baseline_2019 * 100",
      "as": "recovery_index"
    },
    {
      "calculate": "datum.value / 1000",
      "as": "visitor_nights_million"
    }
  ],
  "facet": {
    "field": "category",
    "type": "nominal",
    "sort": [
      "Hotels and similar",
      "Rented accommodation",
      "Caravan / camping",
      "Friends or relatives"
    ],
    "header": {
      "title": null,
      "labelFontSize": 14,
      "labelFontWeight": "bold",
      "labelColor": "#202124",
      "labelPadding": 6,
      "labelLimit": 400
    }
  },
  "columns": 2,
  "spacing": 20,
  "spec": {
    "width": 450,
    "height": 104,
    "layer": [
      {
        "mark": {
          "type": "rule",
          "color": "#7A828A",
          "strokeDash": [5, 4],
          "strokeWidth": 1.2
        },
        "encoding": {
          "y": {"datum": 100, "type": "quantitative"}
        }
      },
      {
        "mark": {
          "type": "line",
          "strokeWidth": 2.5,
          "point": {"filled": true, "size": 45}
        },
        "encoding": {
          "x": {
            "field": "year",
            "type": "quantitative",
            "scale": {
              "domain": [2018.85, 2024.15],
              "nice": false,
              "zero": false
            },
            "axis": {
              "title": null,
              "values": [2019, 2020, 2021, 2022, 2023, 2024],
              "format": "d",
              "labelAngle": 0,
              "labelFontSize": 12,
              "labelPadding": 6,
              "grid": false,
              "domain": false,
              "tickSize": 3,
              "tickColor": "#C9D0D6"
            }
          },
          "y": {
            "field": "recovery_index",
            "type": "quantitative",
            "scale": {
              "domain": [40, 125],
              "nice": false,
              "zero": false
            },
            "axis": {
              "title": "Index (2019 = 100)",
              "values": [50, 75, 100, 125],
              "tickCount": 4,
              "labelOverlap": false,
              "labelFontSize": 12,
              "labelPadding": 5,
              "titleFontSize": 12,
              "titleFontWeight": "normal",
              "titlePadding": 10,
              "grid": true,
              "gridColor": "#E9ECEF",
              "domain": false,
              "tickSize": 0
            }
          },
          "color": {
            "field": "category",
            "type": "nominal",
            "scale": {
              "domain": [
                "Hotels and similar",
                "Rented accommodation",
                "Caravan / camping",
                "Friends or relatives"
              ],
              "range": [
                "#3366A3",
                "#B78118",
                "#A05E93",
                "#3E454D"
              ]
            },
            "legend": null
          },
          "order": {"field": "year", "type": "quantitative"},
          "tooltip": [
            {
              "field": "category",
              "type": "nominal",
              "title": "Accommodation"
            },
            {
              "field": "year",
              "type": "quantitative",
              "title": "Year",
              "format": "d"
            },
            {
              "field": "recovery_index",
              "type": "quantitative",
              "title": "Index (2019 = 100)",
              "format": ".1f"
            },
            {
              "field": "visitor_nights_million",
              "type": "quantitative",
              "title": "Visitor nights (millions)",
              "format": ".1f"
            }
          ]
        }
      }
    ]
  },
  "resolve": {
    "scale": {"x": "shared", "y": "shared"}
  },
  "config": {
    "background": "white",
    "font": "Arial",
    "view": {"stroke": null},
    "axis": {
      "labelColor": "#374151",
      "titleColor": "#374151"
    }
  }
}