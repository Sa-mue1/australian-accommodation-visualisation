{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Monthly occupancy rates for eight states and territories across four selected financial years. National annual rates are weighted by available room nights.",
  "padding": {
    "left": 5,
    "right": 5,
    "top": 5,
    "bottom": 5
  },
  "params": [
    {
      "name": "occupancy_columns",
      "value": 4
    },
    {
      "name": "occupancy_radius",
      "expr": "min(140, (child_width - 28) / 2)"
    }
  ],
  "title": {
    "text": {
      "expr": "occupancy_columns === 1 ? ['Monthly accommodation', 'occupancy'] : 'Monthly accommodation occupancy'"
    },
    "subtitle": [
      "Rings represent states and territories.",
      "Months run clockwise from July."
    ],
    "anchor": "start",
    "fontSize": 18,
    "fontWeight": "bold",
    "subtitleFontSize": 12,
    "subtitleColor": "#202124",
    "subtitleLineHeight": 16,
    "subtitlePadding": 6,
    "offset": 8,
    "limit": {
      "expr": "occupancy_columns * child_width + (occupancy_columns - 1) * 20"
    }
  },
  "data": {
    "url": "data/aam_monthly_state_occupancy_2018_19_to_2024_25.csv",
    "format": {
      "type": "csv",
      "parse": {
        "month_number": "number",
        "occupancy_rate_pct": "number",
        "room_nights_occupied": "number",
        "room_nights_available": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "indexof(['2018-19', '2020-21', '2022-23', '2024-25'], datum.financial_year) >= 0"
    },
    {
      "calculate": "toNumber(datum.month_number)",
      "as": "numeric_month"
    },
    {
      "calculate": "datum.numeric_month >= 7 ? datum.numeric_month - 6 : datum.numeric_month + 6",
      "as": "financial_month"
    },
    {
      "calculate": "(datum.financial_month - 1) * PI / 6",
      "as": "theta_start"
    },
    {
      "calculate": "datum.financial_month * PI / 6",
      "as": "theta_end"
    },
    {
      "calculate": "indexof(['ACT', 'NT', 'TAS', 'SA', 'WA', 'QLD', 'VIC', 'NSW'], datum.state_code)",
      "as": "ring_number"
    },
    {
      "calculate": "['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'][datum.numeric_month - 1]",
      "as": "month_full"
    },
    {
      "calculate": "isValid(datum.occupancy_rate_pct) ? format(datum.occupancy_rate_pct / 100, '.1%') : 'Not available'",
      "as": "occupancy_label"
    },
    {
      "calculate": "replace(datum.financial_year, '-', '–20')",
      "as": "financial_year_full"
    }
  ],
  "facet": {
    "field": "financial_year",
    "type": "nominal",
    "sort": [
      "2018-19",
      "2020-21",
      "2022-23",
      "2024-25"
    ],
    "header": {
      "title": null,
      "labelExpr": "replace(datum.value, '-', '–20')",
      "labelFontSize": 16,
      "labelFontWeight": "bold",
      "labelPadding": 8
    }
  },
  "columns": 4,
  "spacing": 20,
  "spec": {
    "width": 260,
    "height": 310,
    "layer": [
      {
        "transform": [
          {
            "filter": "datum.geography_type === 'State/Territory' && datum.ring_number >= 0"
          }
        ],
        "mark": {
          "type": "arc",
          "theta": {
            "expr": "datum.theta_start"
          },
          "theta2": {
            "expr": "datum.theta_end"
          },
          "radius": {
            "expr": "16 + (datum.ring_number + 1) * (occupancy_radius - 16) / 8 - 0.4"
          },
          "radius2": {
            "expr": "16 + datum.ring_number * (occupancy_radius - 16) / 8 + 0.4"
          },
          "padAngle": 0.007,
          "stroke": "white",
          "strokeWidth": 0.55
        },
        "encoding": {
          "x": {
            "value": {
              "expr": "child_width / 2"
            }
          },
          "y": {
            "value": {
              "expr": "occupancy_radius + 24"
            }
          },
          "color": {
            "condition": {
              "test": "isValid(datum.occupancy_rate_pct)",
              "field": "occupancy_rate_pct",
              "type": "quantitative",
              "scale": {
                "type": "linear",
                "domain": [0, 25, 50, 75, 100],
                "range": [
                  "#F0FCFF",
                  "#C7EFFA",
                  "#79D5F0",
                  "#20A8D8",
                  "#007EA8"
                ],
                "interpolate": "lab",
                "nice": false,
                "clamp": true
              },
              "legend": {
                "title": "Occupancy rate (%)",
                "orient": "bottom",
                "direction": "horizontal",
                "gradientLength": {
                  "expr": "min(300, occupancy_columns * child_width + (occupancy_columns - 1) * 20 - 14)"
                },
                "gradientThickness": 12,
                "values": [0, 20, 40, 60, 80, 100],
                "format": ".0f",
                "titleFontSize": 12,
                "titleFontWeight": "bold",
                "labelFontSize": 12,
                "offset": 8,
                "padding": 0
              }
            },
            "value": "#E5E7EB"
          },
          "tooltip": [
            {
              "field": "financial_year_full",
              "type": "nominal",
              "title": "Financial year"
            },
            {
              "field": "geography",
              "type": "nominal",
              "title": "State or territory"
            },
            {
              "field": "month_full",
              "type": "nominal",
              "title": "Month"
            },
            {
              "field": "occupancy_label",
              "type": "nominal",
              "title": "Occupancy rate"
            }
          ]
        }
      },
      {
        "transform": [
          {
            "filter": "indexof([1, 4, 7, 10], datum.financial_month) >= 0"
          },
          {
            "aggregate": [
              {
                "op": "count",
                "as": "rows"
              }
            ],
            "groupby": [
              "financial_month",
              "month_full",
              "theta_start"
            ]
          }
        ],
        "mark": {
          "type": "text",
          "fontSize": 12,
          "fontWeight": "bold",
          "color": "#202124",
          "baseline": "middle",
          "align": "center",
          "angle": {
            "expr": "datum.financial_month === 4 ? 90 : datum.financial_month === 10 ? 270 : 0"
          }
        },
        "encoding": {
          "x": {
            "value": {
              "expr": "child_width / 2 + sin(datum.theta_start) * (occupancy_radius + 8)"
            }
          },
          "y": {
            "value": {
              "expr": "occupancy_radius + 24 - cos(datum.theta_start) * (occupancy_radius + 8)"
            }
          },
          "text": {
            "field": "month_full"
          },
          "tooltip": null
        }
      },
      {
        "transform": [
          {
            "filter": "datum.geography_type === 'National' && datum.state_code === 'AUS'"
          },
          {
            "aggregate": [
              {
                "op": "sum",
                "field": "room_nights_occupied",
                "as": "occupied"
              },
              {
                "op": "sum",
                "field": "room_nights_available",
                "as": "available"
              }
            ],
            "groupby": ["financial_year_full"]
          },
          {
            "calculate": "datum.occupied / datum.available",
            "as": "annual_occupancy"
          },
          {
            "calculate": "'National occupancy: ' + format(datum.annual_occupancy, '.1%')",
            "as": "annual_label"
          }
        ],
        "mark": {
          "type": "text",
          "align": "center",
          "baseline": "top",
          "fontSize": 14,
          "fontWeight": "bold",
          "color": "#006B8F"
        },
        "encoding": {
          "x": {
            "value": {
              "expr": "child_width / 2"
            }
          },
          "y": {
            "value": {
              "expr": "occupancy_radius * 2 + 52"
            }
          },
          "text": {
            "field": "annual_label"
          },
          "tooltip": [
            {
              "field": "financial_year_full",
              "type": "nominal",
              "title": "Financial year"
            },
            {
              "field": "annual_occupancy",
              "type": "quantitative",
              "title": "Annual national occupancy",
              "format": ".1%"
            },
            {
              "field": "occupied",
              "type": "quantitative",
              "title": "Occupied room nights",
              "format": ",.0f"
            },
            {
              "field": "available",
              "type": "quantitative",
              "title": "Available room nights",
              "format": ",.0f"
            }
          ]
        }
      }
    ]
  },
  "resolve": {
    "scale": {
      "color": "shared"
    }
  },
  "config": {
    "background": "white",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "facet": {
      "spacing": 20
    },
    "legend": {
      "labelColor": "#202124",
      "titleColor": "#202124"
    }
  }
}