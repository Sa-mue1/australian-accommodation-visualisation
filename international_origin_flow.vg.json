{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 330,
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  },
  "padding": {
    "left": 5,
    "right": 5,
    "top": 5,
    "bottom": 5
  },
  "title": {
    "text": "Australia’s largest international visitor markets",
    "subtitle": "Trips to Australia, year ending June 2026",
    "anchor": "start",
    "fontSize": 18,
    "fontWeight": "bold",
    "subtitleFontSize": 12,
    "subtitlePadding": 7,
    "offset": 10
  },
  "data": {
    "url": "data/international_origin_flows.csv",
    "format": {
      "type": "csv",
      "parse": {
        "origin_longitude": "number",
        "origin_latitude": "number",
        "destination_longitude": "number",
        "destination_latitude": "number",
        "trips_2025_thousand": "number",
        "trips_2026_thousand": "number",
        "percent_change": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "datum.percent_change < 0 ? 'Decline' : 'Growth'",
      "as": "change_direction"
    }
  ],
  "projection": {
    "type": "equirectangular",
    "rotate": [-150, 0, 0],
    "fit": {
      "type": "Feature",
      "properties": {},
      "geometry": {
        "type": "MultiPoint",
        "coordinates": [
          [-29.99, 75],
          [-29.99, -55],
          [-30.01, 75],
          [-30.01, -55]
        ]
      }
    },
    "clipExtent": {
      "expr": "[[0, 0], [width, height]]"
    }
  },
  "layer": [
    {
      "data": {
        "sphere": true
      },
      "mark": {
        "type": "geoshape",
        "fill": "#F2F7FA",
        "stroke": null,
        "clip": true
      }
    },
    {
      "data": {
        "graticule": {
          "step": [60, 30]
        }
      },
      "mark": {
        "type": "geoshape",
        "stroke": "#D7E1E7",
        "strokeWidth": 0.45,
        "opacity": 0.65,
        "clip": true
      }
    },
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/vega-datasets@3/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "filter": "toNumber(datum.id) !== 10"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#EBE8E1",
        "stroke": "white",
        "strokeWidth": 0.6,
        "clip": true
      }
    },
    {
      "data": {
        "values": [
          {
            "type": "Feature",
            "geometry": {
              "type": "LineString",
              "coordinates": [
                [0, -55],
                [0, 75]
              ]
            }
          }
        ]
      },
      "mark": {
        "type": "geoshape",
        "filled": false,
        "stroke": "#B8C8D2",
        "strokeWidth": 0.8,
        "strokeDash": [3, 4],
        "clip": true
      }
    },
    {
      "data": {
        "values": [
          {"longitude": 0, "latitude": -49, "label": "0°"},
          {"longitude": -24, "latitude": 30, "label": "30°N"},
          {"longitude": -24, "latitude": 0, "label": "0°"},
          {"longitude": -24, "latitude": -30, "label": "30°S"}
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 9,
        "color": "#7A8C98",
        "align": "left",
        "dx": 3
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "text": {"field": "label"}
      }
    },
    {
      "transform": [
        {
          "calculate": "datum.origin_longitude < -30 ? datum.origin_longitude + 360 : datum.origin_longitude",
          "as": "start_lon"
        },
        {
          "calculate": "datum.origin_country === 'India' ? 67 : datum.origin_country === 'Singapore' ? 113 : datum.origin_country === 'United Kingdom' ? 65 : datum.origin_country === 'United States of America' ? 226 : datum.origin_country === 'Japan' ? 143 : datum.origin_country === 'South Korea' ? 128 : datum.origin_country === 'China' ? 110 : 164",
          "as": "c1_lon"
        },
        {
          "calculate": "datum.origin_country === 'India' ? -8 : datum.origin_country === 'Singapore' ? 0 : datum.origin_country === 'United Kingdom' ? 95 : datum.origin_country === 'United States of America' ? 67 : datum.origin_country === 'Japan' ? 26 : datum.origin_country === 'South Korea' ? 26 : datum.origin_country === 'China' ? 27 : -40",
          "as": "c1_lat"
        },
        {
          "calculate": "datum.origin_country === 'India' ? 90 : datum.origin_country === 'Singapore' ? 125 : datum.origin_country === 'United Kingdom' ? 98 : datum.origin_country === 'United States of America' ? 190 : datum.origin_country === 'Japan' ? 145 : datum.origin_country === 'South Korea' ? 132 : datum.origin_country === 'China' ? 120 : 149",
          "as": "c2_lon"
        },
        {
          "calculate": "datum.origin_country === 'India' ? -42 : datum.origin_country === 'Singapore' ? -12 : datum.origin_country === 'United Kingdom' ? -26 : datum.origin_country === 'United States of America' ? 3 : datum.origin_country === 'Japan' ? -6 : datum.origin_country === 'South Korea' ? 6 : datum.origin_country === 'China' ? -4 : -38",
          "as": "c2_lat"
        },
        {
          "calculate": "sequence(0, 41, 1)",
          "as": "steps"
        },
        {
          "flatten": ["steps"],
          "as": ["step"]
        },
        {
          "calculate": "datum.step / 40",
          "as": "t"
        },
        {
          "calculate": "pow(1 - datum.t, 3) * datum.start_lon + 3 * pow(1 - datum.t, 2) * datum.t * datum.c1_lon + 3 * (1 - datum.t) * pow(datum.t, 2) * datum.c2_lon + pow(datum.t, 3) * datum.destination_longitude",
          "as": "route_lon"
        },
        {
          "calculate": "pow(1 - datum.t, 3) * datum.origin_latitude + 3 * pow(1 - datum.t, 2) * datum.t * datum.c1_lat + 3 * (1 - datum.t) * pow(datum.t, 2) * datum.c2_lat + pow(datum.t, 3) * datum.destination_latitude",
          "as": "route_lat"
        }
      ],
      "mark": {
        "type": "line",
        "interpolate": "basis",
        "strokeCap": "round",
        "opacity": 0.72,
        "clip": true
      },
      "encoding": {
        "longitude": {
          "field": "route_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "route_lat",
          "type": "quantitative"
        },
        "detail": {
          "field": "origin_country",
          "type": "nominal"
        },
        "order": {
          "field": "step",
          "type": "quantitative",
          "sort": "ascending"
        },
        "color": {
          "field": "change_direction",
          "type": "nominal",
          "scale": {
            "domain": ["Growth", "Decline"],
            "range": ["#BD2674", "#55606D"]
          },
          "legend": {
            "title": "Change since 2025",
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 2,
            "titleOrient": "left",
            "titleAnchor": "middle",
            "titlePadding": 10,
            "labelFontSize": 11,
            "titleFontSize": 12,
            "titleFontWeight": "bold",
            "symbolType": "stroke",
            "symbolStrokeWidth": 4,
            "symbolSize": 400,
            "columnPadding": 16,
            "offset": 8
          }
        },
        "strokeWidth": {
          "field": "trips_2026_thousand",
          "type": "quantitative",
          "scale": {
            "domain": [0, 1300],
            "range": [0, 10],
            "zero": true
          },
          "legend": {
            "title": "Trips (thousands)",
            "orient": "bottom",
            "direction": "horizontal",
            "values": [400, 800, 1200],
            "format": ",.0f",
            "symbolType": "stroke",
            "symbolStrokeColor": "#7A8490",
            "symbolSize": 400,
            "columns": 3,
            "columnPadding": 20,
            "titleOrient": "left",
            "titleAnchor": "middle",
            "titlePadding": 12,
            "offset": 8,
            "labelFontSize": 11,
            "titleFontSize": 12,
            "titleFontWeight": "bold"
          }
        },
        "tooltip": [
          {
            "field": "origin_country",
            "type": "nominal",
            "title": "Visitor market"
          },
          {
            "field": "trips_2026_thousand",
            "type": "quantitative",
            "title": "2026 trips (thousands)",
            "format": ",.1f"
          },
          {
            "field": "trips_2025_thousand",
            "type": "quantitative",
            "title": "2025 trips (thousands)",
            "format": ",.1f"
          },
          {
            "field": "percent_change",
            "type": "quantitative",
            "title": "Change from 2025 (%)",
            "format": "+.1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 100,
        "opacity": 1,
        "stroke": "white",
        "strokeWidth": 1.2
      },
      "encoding": {
        "longitude": {
          "field": "origin_longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "origin_latitude",
          "type": "quantitative"
        },
        "color": {
          "field": "change_direction",
          "type": "nominal",
          "scale": {
            "domain": ["Growth", "Decline"],
            "range": ["#BD2674", "#55606D"]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "origin_country",
            "type": "nominal",
            "title": "Visitor market"
          },
          {
            "field": "trips_2026_thousand",
            "type": "quantitative",
            "title": "2026 trips (thousands)",
            "format": ",.1f"
          },
          {
            "field": "percent_change",
            "type": "quantitative",
            "title": "Change from 2025 (%)",
            "format": "+.1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "calculate": "datum.origin_country === 'United States of America' ? 'USA' : datum.origin_country === 'United Kingdom' ? 'UK' : datum.origin_country === 'South Korea' ? 'S. Korea' : datum.origin_country",
          "as": "origin_label"
        },
        {
          "calculate": "datum.origin_country === 'China' || datum.origin_country === 'India' || datum.origin_country === 'New Zealand' || datum.origin_country === 'United Kingdom' ? 'right' : datum.origin_country === 'South Korea' || datum.origin_country === 'Singapore' ? 'center' : 'left'",
          "as": "label_align"
        },
        {
          "calculate": "datum.origin_country === 'United Kingdom' || datum.origin_country === 'India' ? -12 : datum.label_align === 'right' ? -9 : datum.label_align === 'center' ? 0 : 9",
          "as": "label_dx"
        },
        {
          "calculate": "datum.origin_country === 'United Kingdom' ? -12 : datum.origin_country === 'India' ? 3 : datum.origin_country === 'Singapore' ? -25 : datum.origin_country === 'South Korea' ? -22 : datum.origin_country === 'Japan' ? 3 : datum.origin_country === 'New Zealand' ? 16 : -11",
          "as": "label_dy"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontWeight": "bold",
        "color": "#374151",
        "align": {"expr": "datum.label_align"},
        "dx": {"expr": "datum.label_dx"},
        "dy": {"expr": "datum.label_dy"}
      },
      "encoding": {
        "longitude": {
          "field": "origin_longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "origin_latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "origin_label"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "country": "Australia",
            "longitude": 133.7751,
            "latitude": -25.2744
          }
        ]
      },
      "mark": {
        "type": "circle",
        "size": 250,
        "color": "#243746",
        "opacity": 1,
        "stroke": "white",
        "strokeWidth": 1.5
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Destination"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "label": "Australia",
            "longitude": 133.7751,
            "latitude": -25.2744
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#202124",
        "align": "right",
        "dx": -14,
        "dy": 25
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "text": {"field": "label"}
      }
    },
    {
      "transform": [
        {
          "calculate": "datum.trips_2026_thousand - datum.trips_2025_thousand",
          "as": "trip_increase"
        },
        {
          "calculate": "datum.origin_country === 'New Zealand' || datum.origin_country === 'China' ? datum.trips_2026_thousand : 0",
          "as": "pair_trips"
        },
        {
          "joinaggregate": [
            {"op": "sum", "field": "trip_increase", "as": "total_increase"},
            {"op": "sum", "field": "trips_2026_thousand", "as": "total_trips"},
            {"op": "sum", "field": "pair_trips", "as": "pair_total"}
          ]
        },
        {
          "filter": "datum.origin_country === 'China'"
        },
        {
          "calculate": "'China drove ' + format(datum.trip_increase / datum.total_increase, '.0%') + ' of net growth'",
          "as": "growth_heading"
        },
        {
          "calculate": "'China added ' + format(round(datum.trip_increase) * 1000, ',.0f') + ' of the\\\\n' + format(round(datum.total_increase) * 1000, ',.0f') + ' extra trips across\\\\nthese eight markets.'",
          "as": "growth_body"
        },
        {
          "calculate": "'Two markets supplied ' + format(datum.pair_total / datum.total_trips, '.0%')",
          "as": "share_heading"
        },
        {
          "calculate": "'New Zealand and China\\\\naccounted for ' + format(datum.pair_total / datum.total_trips, '.0%') + ' of trips\\\\nacross the markets shown.'",
          "as": "share_body"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "rect",
            "fill": "#F5F9FC",
            "stroke": "#B8CAD7",
            "strokeWidth": 1,
            "cornerRadius": 4,
            "opacity": 0.98
          },
          "encoding": {
            "x": {"value": {"expr": "width * 0.59"}},
            "x2": {
              "value": {
                "expr": "width * 0.59 + min(220, width * 0.27)"
              }
            },
            "y": {"value": 176},
            "y2": {"value": 244}
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "fontSize": 10,
            "fontWeight": "bold",
            "color": "#184E65",
            "lineBreak": "\\n",
            "lineHeight": 12
          },
          "encoding": {
            "x": {"value": {"expr": "width * 0.59 + 12"}},
            "y": {"value": 187},
            "text": {"field": "growth_heading"}
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "fontSize": 10,
            "fontWeight": "normal",
            "color": "#374151",
            "lineBreak": "\\n",
            "lineHeight": 12
          },
          "encoding": {
            "x": {"value": {"expr": "width * 0.59 + 12"}},
            "y": {"value": 204},
            "text": {"field": "growth_body"}
          }
        },
        {
          "mark": {
            "type": "rect",
            "fill": "#F5F9FC",
            "stroke": "#B8CAD7",
            "strokeWidth": 1,
            "cornerRadius": 4,
            "opacity": 0.98
          },
          "encoding": {
            "x": {"value": {"expr": "width * 0.59"}},
            "x2": {
              "value": {
                "expr": "width * 0.59 + min(220, width * 0.27)"
              }
            },
            "y": {"value": 254},
            "y2": {"value": 322}
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "fontSize": 10,
            "fontWeight": "bold",
            "color": "#184E65",
            "lineBreak": "\\n",
            "lineHeight": 12
          },
          "encoding": {
            "x": {"value": {"expr": "width * 0.59 + 12"}},
            "y": {"value": 265},
            "text": {"field": "share_heading"}
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "fontSize": 10,
            "fontWeight": "normal",
            "color": "#374151",
            "lineBreak": "\\n",
            "lineHeight": 12
          },
          "encoding": {
            "x": {"value": {"expr": "width * 0.59 + 12"}},
            "y": {"value": 282},
            "text": {"field": "share_body"}
          }
        }
      ]
    }
  ],
  "config": {
    "background": "white",
    "font": "Arial",
    "view": {
      "stroke": null
    }
  }
}