{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Distributions of positive advertised nightly prices up to AUD 1,000. Curves show relative concentration within room types, not listing counts. Dashed lines show medians. These are advertised prices, not confirmed booking prices.",
  "padding": {
    "left": 5,
    "right": 5,
    "top": 5,
    "bottom": 5
  },
  "title": {
    "text": "Advertised rental prices by room type",
    "subtitle": "Prices up to $1,000; dots mark peaks, dashes mark medians.",
    "anchor": "start",
    "fontSize": 17,
    "fontWeight": "bold",
    "subtitleFontSize": 12,
    "subtitleColor": "#202124",
    "subtitleLineHeight": 16,
    "subtitlePadding": 7,
    "offset": 8,
    "limit": {
      "expr": "child_width"
    }
  },
  "data": {
    "url": "./data/short_term_rental_listings.csv",
    "format": {
      "type": "csv",
      "parse": {
        "price_aud": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "isValid(datum.price_aud) && datum.price_aud > 0 && datum.price_aud <= 1000"
    },
    {
      "filter": "indexof(['Sydney', 'Melbourne'], datum.city) >= 0 && indexof(['Entire home/apt', 'Private room', 'Hotel room', 'Shared room'], datum.room_type) >= 0"
    },
    {
      "calculate": "indexof(['Entire home/apt', 'Private room', 'Hotel room', 'Shared room'], datum.room_type)",
      "as": "room_order"
    },
    {
      "joinaggregate": [
        {
          "op": "median",
          "field": "price_aud",
          "as": "median_price"
        },
        {
          "op": "count",
          "as": "listing_count"
        }
      ],
      "groupby": ["city", "room_type"]
    }
  ],
  "facet": {
    "row": {
      "field": "room_type",
      "type": "nominal",
      "sort": {
        "field": "room_order",
        "op": "min",
        "order": "ascending"
      },
      "header": {
        "labels": false,
        "title": null
      }
    }
  },
  "spacing": 10,
  "spec": {
    "width": 468,
    "height": 64,
    "transform": [
      {
        "density": "price_aud",
        "groupby": [
          "city",
          "room_type",
          "room_order",
          "median_price",
          "listing_count"
        ],
        "extent": [0, 1000],
        "steps": 120,
        "bandwidth": 25,
        "as": ["nightly_price", "density"]
      },
      {
        "joinaggregate": [
          {
            "op": "max",
            "field": "density",
            "as": "panel_peak"
          }
        ],
        "groupby": ["room_type"]
      },
      {
        "calculate": "datum.density / datum.panel_peak",
        "as": "relative_density"
      }
    ],
    "encoding": {
      "x": {
        "field": "nightly_price",
        "type": "quantitative",
        "scale": {
          "domain": [0, 1000],
          "nice": false
        },
        "axis": {
          "title": "Advertised nightly price (AUD)",
          "format": "$,.0f",
          "values": [0, 200, 400, 600, 800, 1000],
          "grid": true,
          "gridColor": "#E5E7EB",
          "gridOpacity": 0.8,
          "labelFontSize": 12,
          "labelPadding": 6,
          "titleFontSize": 13,
          "titleFontWeight": "bold",
          "titlePadding": 10,
          "domainColor": "#B9C2CB",
          "tickSize": 3
        }
      },
      "y": {
        "field": "relative_density",
        "type": "quantitative",
        "scale": {
          "domain": [0, 1.45],
          "nice": false
        },
        "axis": null,
        "stack": null
      },
      "color": {
        "field": "city",
        "type": "nominal",
        "scale": {
          "domain": ["Sydney", "Melbourne"],
          "range": ["#007C91", "#C65D21"]
        },
        "legend": {
          "title": "City",
          "orient": "bottom",
          "direction": "horizontal",
          "columns": 2,
          "labelFontSize": 12,
          "symbolSize": 85,
          "symbolOpacity": 1,
          "offset": 8,
          "padding": 0,
          "titleOrient": "left",
          "titleAnchor": "middle",
          "titleFontSize": 12,
          "titleFontWeight": "bold",
          "titlePadding": 8
        }
      }
    },
    "layer": [
      {
        "mark": {
          "type": "area",
          "interpolate": "monotone",
          "opacity": 0.18,
          "clip": true
        }
      },
      {
        "mark": {
          "type": "line",
          "interpolate": "monotone",
          "strokeWidth": 2.2,
          "clip": true
        },
        "encoding": {
          "tooltip": [
            {
              "field": "city",
              "type": "nominal",
              "title": "City"
            },
            {
              "field": "room_type",
              "type": "nominal",
              "title": "Room type"
            },
            {
              "field": "nightly_price",
              "type": "quantitative",
              "title": "Advertised price",
              "format": "$,.0f"
            },
            {
              "field": "listing_count",
              "type": "quantitative",
              "title": "Listings displayed",
              "format": ","
            }
          ]
        }
      },
      {
        "transform": [
          {
            "aggregate": [
              {
                "op": "max",
                "field": "median_price",
                "as": "median_price"
              },
              {
                "op": "max",
                "field": "listing_count",
                "as": "listing_count"
              }
            ],
            "groupby": ["city", "room_type"]
          }
        ],
        "mark": {
          "type": "rule",
          "strokeWidth": 1.5,
          "strokeDash": [4, 3],
          "opacity": 0.85
        },
        "encoding": {
          "x": {
            "field": "median_price",
            "type": "quantitative"
          },
          "y": {
            "value": 25
          },
          "y2": {
            "value": {
              "expr": "child_height"
            }
          },
          "tooltip": [
            {
              "field": "city",
              "type": "nominal",
              "title": "City"
            },
            {
              "field": "median_price",
              "type": "quantitative",
              "title": "Median displayed price",
              "format": "$,.0f"
            },
            {
              "field": "listing_count",
              "type": "quantitative",
              "title": "Listings displayed",
              "format": ","
            }
          ]
        }
      },
      {
        "transform": [
          {
            "window": [
              {
                "op": "row_number",
                "as": "peak_rank"
              }
            ],
            "sort": [
              {
                "field": "density",
                "order": "descending"
              },
              {
                "field": "nightly_price",
                "order": "ascending"
              }
            ],
            "groupby": ["city", "room_type"]
          },
          {
            "filter": "datum.peak_rank === 1"
          }
        ],
        "mark": {
          "type": "circle",
          "size": 58,
          "stroke": "white",
          "strokeWidth": 1.4,
          "opacity": 1
        },
        "encoding": {
          "tooltip": [
            {
              "field": "city",
              "type": "nominal",
              "title": "City"
            },
            {
              "field": "nightly_price",
              "type": "quantitative",
              "title": "Estimated peak price",
              "format": "$,.0f"
            },
            {
              "field": "listing_count",
              "type": "quantitative",
              "title": "Listings displayed",
              "format": ","
            }
          ]
        }
      },
      {
        "transform": [
          {
            "aggregate": [
              {
                "op": "count",
                "as": "rows"
              }
            ],
            "groupby": ["room_type"]
          },
          {
            "calculate": "datum.room_type === 'Entire home/apt' ? 'Entire home or apartment' : datum.room_type === 'Hotel room' ? 'Listed hotel rooms' : datum.room_type + 's'",
            "as": "room_label"
          }
        ],
        "mark": {
          "type": "text",
          "align": "left",
          "baseline": "top",
          "fontSize": 13,
          "fontWeight": "bold",
          "limit": {
            "expr": "child_width * 0.54"
          }
        },
        "encoding": {
          "x": {
            "value": 0
          },
          "y": {
            "value": 0
          },
          "color": {
            "value": "#202124"
          },
          "text": {
            "field": "room_label"
          },
          "tooltip": null
        }
      },
      {
        "transform": [
          {
            "window": [
              {
                "op": "row_number",
                "as": "peak_rank"
              }
            ],
            "sort": [
              {
                "field": "density",
                "order": "descending"
              },
              {
                "field": "nightly_price",
                "order": "ascending"
              }
            ],
            "groupby": ["city", "room_type"]
          },
          {
            "filter": "datum.peak_rank === 1"
          },
          {
            "calculate": "datum.city + ' peak ≈ $' + format(round(datum.nightly_price / 10) * 10, ',.0f')",
            "as": "peak_label"
          },
          {
            "calculate": "datum.city === 'Sydney' ? 0 : 24",
            "as": "box_y"
          },
          {
            "calculate": "datum.box_y + 20",
            "as": "box_bottom"
          },
          {
            "calculate": "datum.box_y + 10",
            "as": "text_y"
          }
        ],
        "layer": [
          {
            "mark": {
              "type": "rect",
              "cornerRadius": 3,
              "strokeWidth": 0.8,
              "tooltip": null
            },
            "encoding": {
              "x": {
                "value": {
                  "expr": "child_width - 192"
                }
              },
              "x2": {
                "value": {
                  "expr": "child_width - 8"
                }
              },
              "y": {
                "field": "box_y",
                "type": "quantitative",
                "scale": null
              },
              "y2": {
                "field": "box_bottom"
              },
              "color": {
                "condition": {
                  "test": "datum.city === 'Sydney'",
                  "value": "#EDF7F8"
                },
                "value": "#FCF2E9"
              },
              "stroke": {
                "condition": {
                  "test": "datum.city === 'Sydney'",
                  "value": "#007C91"
                },
                "value": "#C65D21"
              }
            }
          },
          {
            "mark": {
              "type": "text",
              "align": "left",
              "baseline": "middle",
              "fontSize": 12,
              "fontWeight": "bold",
              "tooltip": null
            },
            "encoding": {
              "x": {
                "value": {
                  "expr": "child_width - 182"
                }
              },
              "y": {
                "field": "text_y",
                "type": "quantitative",
                "scale": null
              },
              "text": {
                "field": "peak_label"
              },
              "color": {
                "condition": {
                  "test": "datum.city === 'Sydney'",
                  "value": "#007C91"
                },
                "value": "#B4521A"
              }
            }
          }
        ]
      }
    ]
  },
  "resolve": {
    "scale": {
      "x": "shared",
      "y": "shared",
      "color": "shared"
    }
  },
  "config": {
    "background": "white",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#202124",
      "titleColor": "#202124"
    },
    "facet": {
      "spacing": 10
    },
    "legend": {
      "labelColor": "#202124"
    }
  }
}