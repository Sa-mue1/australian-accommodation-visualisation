{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 360,
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  },
  "padding": {
    "left": 5,
    "right": 5,
    "top": 5,
    "bottom": 5
  },
  "title": {
    "text": "Domestic accommodation visitor nights",
    "subtitle": "Domestic visitor nights by accommodation type, 2019–2024 values in millions.",
    "anchor": "start",
    "fontSize": 18,
    "fontWeight": "bold",
    "subtitleFontSize": 12,
    "subtitleFontWeight": "normal",
    "subtitlePadding": 7,
    "offset": 8
  },
  "data": {
    "url": "data/domestic_accommodation_types.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "value": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.geography === 'Australia' && datum.area_type === 'australia_total' && datum.measure === 'visitor_nights_thousand' && datum.accommodation_type !== 'All accommodation' && datum.data_status === 'published' && datum.year >= 2019 && datum.year <= 2024"
    },
    {
      "calculate": "datum.accommodation_type === 'Hotels and similar' ? 'Hotels' : datum.accommodation_type === \"Friends or relatives' property\" ? 'Friends or relatives' : datum.accommodation_type === 'Rented accommodation' ? 'Rented accommodation' : datum.accommodation_type === 'Caravan park or commercial camping' ? 'Caravan/camping' : 'Other'",
      "as": "category"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "value",
          "as": "visitor_nights_thousand"
        }
      ],
      "groupby": ["year", "category"]
    },
    {
      "calculate": "datum.visitor_nights_thousand / 1000",
      "as": "visitor_nights_million"
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "visitor_nights_million",
          "as": "year_total_million"
        }
      ],
      "groupby": ["year"]
    },
    {
      "calculate": "datum.visitor_nights_million / datum.year_total_million",
      "as": "annual_share"
    },
    {
      "calculate": "datum.category === 'Friends or relatives' ? 1 : datum.category === 'Hotels' ? 2 : datum.category === 'Rented accommodation' ? 3 : datum.category === 'Caravan/camping' ? 4 : 5",
      "as": "category_order"
    },
    {
      "calculate": "datum.category === 'Other' ? 'Own property; guesthouses; bed and breakfasts; miscellaneous accommodation' : datum.category",
      "as": "category_coverage"
    }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "scale": {
        "domain": [2019, 2024],
        "nice": false,
        "zero": false
      },
      "axis": {
        "title": "Year",
        "values": [2019, 2020, 2021, 2022, 2023, 2024],
        "format": "d",
        "labelAngle": 0,
        "labelFontSize": 12,
        "labelFontWeight": "bold",
        "labelPadding": 8,
        "titleFontSize": 13,
        "titleFontWeight": "bold",
        "titlePadding": 10,
        "grid": false,
        "domain": false,
        "tickSize": 3,
        "tickColor": "#C9D0D6"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "interpolate": "monotone",
        "opacity": 0.94,
        "stroke": "white",
        "strokeWidth": 0.8
      },
      "encoding": {
        "y": {
          "field": "visitor_nights_million",
          "type": "quantitative",
          "stack": "center",
          "scale": {
            "domainMin": 0,
            "nice": false
          },
          "axis": {
            "title": "Visitor nights (millions)",
            "labels": false,
            "ticks": false,
            "domain": false,
            "grid": false,
            "titleFontSize": 13,
            "titleFontWeight": "bold",
            "titlePadding": 14
          }
        },
        "color": {
          "field": "category",
          "type": "nominal",
          "scale": {
            "domain": [
              "Friends or relatives",
              "Hotels",
              "Rented accommodation",
              "Caravan/camping",
              "Other"
            ],
            "range": [
              "#3E454D",
              "#3366A3",
              "#B78118",
              "#A05E93",
              "#B8BDC5"
            ]
          },
          "legend": {
            "title": null,
            "orient": "top",
            "direction": "horizontal",
            "columns": 5,
            "labelFontSize": 12,
            "labelLimit": 180,
            "symbolType": "square",
            "symbolSize": 100,
            "columnPadding": 18,
            "rowPadding": 6,
            "offset": 8
          }
        },
        "order": {
          "field": "category_order",
          "type": "quantitative",
          "sort": "ascending"
        },
        "tooltip": [
          {
            "field": "year",
            "type": "quantitative",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "category",
            "type": "nominal",
            "title": "Accommodation"
          },
          {
            "field": "visitor_nights_million",
            "type": "quantitative",
            "title": "Visitor nights",
            "format": ".1f"
          },
          {
            "field": "annual_share",
            "type": "quantitative",
            "title": "Share of annual nights",
            "format": ".1%"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === 2020 && datum.category === 'Hotels'"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#4B5563",
        "strokeDash": [5, 4],
        "strokeWidth": 1.2,
        "opacity": 0.75
      },
      "encoding": {
        "y": {
          "value": 0
        },
        "y2": {
          "value": {
            "expr": "height * 0.86"
          }
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === 2020 && datum.category === 'Hotels'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "dx": 9,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#202124"
      },
      "encoding": {
        "y": {
          "value": 8
        },
        "text": {
          "value": "2020: visitor nights fell"
        }
      }
    },
    {
      "transform": [
        {
          "stack": "visitor_nights_million",
          "groupby": ["year"],
          "sort": [
            {
              "field": "category_order",
              "order": "ascending"
            }
          ],
          "offset": "center",
          "as": ["anchor_start", "anchor_end"]
        },
        {
          "filter": "datum.year === 2020 && datum.category === 'Friends or relatives'"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#3E454D",
        "strokeWidth": 1.2
      },
      "encoding": {
        "y": {
          "field": "anchor_start",
          "type": "quantitative"
        },
        "x2": {
          "datum": 2020
        },
        "y2": {
          "datum": 45
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === 2020 && datum.category === 'Friends or relatives'"
        }
      ],
      "mark": {
        "type": "rect",
        "fill": "#E8F3F8",
        "stroke": "#BED9E8",
        "strokeWidth": 1,
        "cornerRadius": 4
      },
      "encoding": {
        "x": {
          "datum": 2019.85,
          "type": "quantitative"
        },
        "x2": {
          "value": {
            "expr": "width * 0.17 + 224"
          }
        },
        "y": {
          "datum": 45,
          "type": "quantitative"
        },
        "y2": {
          "datum": 6
        }
      }
    },
    {
      "transform": [
        {
          "stack": "visitor_nights_million",
          "groupby": ["year"],
          "sort": [
            {
              "field": "category_order",
              "order": "ascending"
            }
          ],
          "offset": "center",
          "as": ["anchor_start", "anchor_end"]
        },
        {
          "filter": "datum.year === 2020 && datum.category === 'Friends or relatives'"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 28,
        "color": "#3E454D",
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "y": {
          "field": "anchor_start",
          "type": "quantitative"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === 2020 && datum.category === 'Friends or relatives'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 10,
        "fontSize": 12,
        "fontWeight": "bold",
        "lineBreak": "\n",
        "lineHeight": 14,
        "color": "#202124"
      },
      "encoding": {
        "x": {
          "datum": 2019.85,
          "type": "quantitative"
        },
        "y": {
          "datum": 33.5,
          "type": "quantitative"
        },
        "text": {
          "value": "Friends or relatives led\nvisitor nights in every year."
        }
      }
    }
  ],
  "config": {
    "background": "white",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#374151",
      "titleColor": "#202124"
    }
  }
}