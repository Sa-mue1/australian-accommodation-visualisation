{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": "container",
  "height": 300,

  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  },

  "padding": {
    "left": 5,
    "right": 5,
    "top": 5,
    "bottom": 5
  },

  "title": {
    "text": "Hotel nights recovered, but stays with friends remained largest",
    "subtitle": "Australian domestic visitor nights by accommodation type, 2019–2024",
    "anchor": "start",
    "fontSize": 18,
    "fontWeight": "bold",
    "subtitleFontSize": 12,
    "subtitleFontWeight": "normal",
    "subtitlePadding": 7,
    "offset": 12
  },

  "data": {
    "url": "data/domestic_accommodation_types.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "value": "number"
      }
    }
  },

  "transform": [
    {
      "filter": "datum.geography === 'Australia' && datum.area_type === 'australia_total' && datum.measure === 'visitor_nights_thousand' && datum.accommodation_type !== 'All accommodation' && datum.data_status === 'published' && datum.year >= 2019 && datum.year <= 2024"
    },
    {
      "calculate": "datum.accommodation_type === 'Hotels and similar' ? 'Hotels' : datum.accommodation_type === \"Friends or relatives' property\" ? 'Friends or relatives' : datum.accommodation_type === 'Rented accommodation' ? 'Rented accommodation' : datum.accommodation_type === 'Caravan park or commercial camping' ? 'Caravan/camping' : 'Other'",
      "as": "category"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "value",
          "as": "visitor_nights_thousand"
        }
      ],
      "groupby": [
        "year",
        "category"
      ]
    },
    {
      "calculate": "datum.visitor_nights_thousand / 1000",
      "as": "visitor_nights_million"
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "visitor_nights_million",
          "as": "year_total_million"
        }
      ],
      "groupby": [
        "year"
      ]
    },
    {
      "calculate": "datum.visitor_nights_million / datum.year_total_million * 100",
      "as": "share_percent"
    },
    {
      "calculate": "datum.category === 'Friends or relatives' ? 1 : datum.category === 'Hotels' ? 2 : datum.category === 'Rented accommodation' ? 3 : datum.category === 'Caravan/camping' ? 4 : 5",
      "as": "category_order"
    }
  ],

  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "scale": {
        "domain": [
          2019,
          2024
        ],
        "nice": false,
        "zero": false
      },
      "axis": {
        "title": "Year",
        "values": [
          2019,
          2020,
          2021,
          2022,
          2023,
          2024
        ],
        "format": "d",
        "labelAngle": 0,
        "labelFontSize": 12,
        "labelPadding": 7,
        "titleFontSize": 13,
        "titlePadding": 10,
        "grid": false,
        "domain": false,
        "tickSize": 3,
        "tickColor": "#C9D0D6"
      }
    }
  },

  "layer": [
    {
      "mark": {
        "type": "area",
        "interpolate": "monotone",
        "opacity": 0.94,
        "stroke": "white",
        "strokeWidth": 0.8
      },

      "encoding": {
        "y": {
          "field": "visitor_nights_million",
          "type": "quantitative",
          "stack": "center",
          "axis": {
            "title": "Domestic visitor nights (millions; band thickness)",
            "labels": false,
            "ticks": false,
            "domain": false,
            "grid": false,
            "titleFontSize": 13,
            "titleFontWeight": "normal",
            "titlePadding": 14
          }
        },

        "color": {
          "field": "category",
          "type": "nominal",
          "scale": {
            "domain": [
              "Friends or relatives",
              "Hotels",
              "Rented accommodation",
              "Caravan/camping",
              "Other"
            ],
            "range": [
              "#0072B2",
              "#E69F00",
              "#009E73",
              "#CC79A7",
              "#999999"
            ]
          },
          "legend": {
            "title": null,
            "orient": "top",
            "direction": "horizontal",
            "columns": 5,
            "labelFontSize": 12,
            "labelLimit": 180,
            "symbolType": "square",
            "symbolSize": 100,
            "columnPadding": 18,
            "rowPadding": 6,
            "offset": 12
          }
        },

        "order": {
          "field": "category_order",
          "type": "quantitative",
          "sort": "ascending"
        },

        "tooltip": [
          {
            "field": "year",
            "type": "quantitative",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "category",
            "type": "nominal",
            "title": "Accommodation type"
          },
          {
            "field": "visitor_nights_million",
            "type": "quantitative",
            "title": "Visitor nights (millions)",
            "format": ".1f"
          },
          {
            "field": "share_percent",
            "type": "quantitative",
            "title": "Share of annual nights (%)",
            "format": ".1f"
          }
        ]
      }
    },

    {
      "transform": [
        {
          "filter": "datum.year === 2020 && datum.category === 'Hotels'"
        }
      ],

      "mark": {
        "type": "rule",
        "color": "#4B5563",
        "strokeDash": [
          5,
          4
        ],
        "strokeWidth": 1.2,
        "opacity": 0.75
      }
    },

    {
      "transform": [
        {
          "filter": "datum.year === 2020 && datum.category === 'Hotels'"
        }
      ],

      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "dx": 8,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#374151"
      },

      "encoding": {
        "y": {
          "value": 8
        },
        "text": {
          "value": "2020 disruption"
        }
      }
    }
  ],

  "config": {
    "background": "white",
    "font": "Arial",

    "view": {
      "stroke": null
    },

    "axis": {
      "labelColor": "#374151",
      "titleColor": "#374151"
    }
  }
}