{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 330,
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  },
  "padding": {
    "left": 5,
    "right": 5,
    "top": 5,
    "bottom": 5
  },
  "title": {
    "text": [
      "International visitor-night growth",
      "varied across states"
    ],
    "subtitle": [
      "Percentage change, visitor-night totals are in millions",
      "Years ending June 2025 and June 2026"
    ],
    "anchor": "start",
    "fontSize": 17,
    "fontWeight": "bold",
    "lineHeight": 21,
    "subtitleFontSize": 12,
    "subtitleColor": "#5F6368",
    "subtitleLineHeight": 15,
    "subtitlePadding": 7,
    "offset": 10
  },
  "params": [
    {"name": "map_zoom", "value": 1},
    {"name": "map_pan_x", "value": 0},
    {"name": "map_pan_y", "value": 0}
  ],
  "projection": {
    "type": "conicEqualArea",
    "parallels": [-18, -36],
    "rotate": [-132, 0, 0],
    "fit": {
      "type": "Feature",
      "properties": {},
      "geometry": {
        "type": "MultiPoint",
        "coordinates": [
          [110, -9],
          [165, -9],
          [110, -45],
          [165, -45]
        ]
      }
    },
    "extent": {
      "expr": "[[width / 2 + map_pan_x - (width - 16) * map_zoom / 2, height / 2 + map_pan_y - (height - 12) * map_zoom / 2], [width / 2 + map_pan_x + (width - 16) * map_zoom / 2, height / 2 + map_pan_y + (height - 12) * map_zoom / 2]]"
    },
    "clipExtent": {
      "expr": "[[0, 0], [width, height]]"
    }
  },
  "layer": [
    {
      "data": {"sphere": true},
      "mark": {
        "type": "geoshape",
        "fill": "#EAF3F8",
        "stroke": null,
        "clip": true
      }
    },
    {
      "data": {
        "graticule": {
          "step": [10, 10],
          "extent": [[108, -50], [158, -5]]
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#B7CDD8",
        "strokeWidth": 0.6,
        "opacity": 0.8,
        "clip": true
      }
    },
    {
      "data": {
        "url": "data/geo/australian_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "STE_2021_AUST_GDA2020"
        }
      },
      "transform": [
        {
          "filter": "indexof(['1','2','3','4','5','6','7','8'], datum.properties.STE_CODE21) >= 0"
        },
        {
          "calculate": "'Unavailable data'",
          "as": "availability"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#D4D9DF",
        "stroke": "white",
        "strokeWidth": 1.1,
        "clip": true
      },
      "encoding": {
        "tooltip": [
          {
            "field": "properties.STE_NAME21",
            "type": "nominal",
            "title": "State or territory"
          },
          {
            "field": "availability",
            "type": "nominal",
            "title": "Visitor-night change"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/international_states.csv",
        "format": {
          "type": "csv",
          "parse": {
            "value": "number",
            "change_from_2025": "number",
            "percent_change_from_2025": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.period === 'Year ending June 2026' && datum.metric === 'nights_thousand'"
        },
        {
          "calculate": "datum.value - datum.change_from_2025",
          "as": "nights_2025"
        },
        {
          "calculate": "datum.nights_2025 / 1000",
          "as": "nights_2025_million"
        },
        {
          "calculate": "datum.value / 1000",
          "as": "nights_2026_million"
        },
        {
          "calculate": "datum.percent_change_from_2025 / 100",
          "as": "change_fraction"
        },
        {
          "lookup": "state_or_territory",
          "from": {
            "data": {
              "url": "data/geo/australian_states.topojson",
              "format": {
                "type": "topojson",
                "feature": "STE_2021_AUST_GDA2020"
              }
            },
            "key": "properties.STE_NAME21"
          },
          "as": "geo"
        },
        {
          "filter": "isValid(datum.percent_change_from_2025) && isValid(datum.geo)"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 1.1,
        "clip": true
      },
      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        },
        "color": {
          "field": "percent_change_from_2025",
          "type": "quantitative",
          "title": "Visitor-night change (%)",
          "scale": {
            "domain": [-20, 0, 20],
            "range": ["#C73E3E", "#FAF8F3", "#243C5A"],
            "interpolate": "lab",
            "nice": false,
            "clamp": true
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "titleOrient": "top",
            "titleAnchor": "start",
            "gradientLength": {
              "expr": "min(330, width - 20)"
            },
            "gradientThickness": 11,
            "format": "+.0f",
            "values": [-20, -10, 0, 10, 20],
            "offset": 8
          }
        },
        "tooltip": [
          {
            "field": "state_or_territory",
            "type": "nominal",
            "title": "State or territory"
          },
          {
            "field": "nights_2025_million",
            "type": "quantitative",
            "title": "2025 visitor nights",
            "format": ",.1f"
          },
          {
            "field": "nights_2026_million",
            "type": "quantitative",
            "title": "2026 visitor nights",
            "format": ",.1f"
          },
          {
            "field": "change_fraction",
            "type": "quantitative",
            "title": "Change from 2025",
            "format": "+.1%"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {"longitude": 120, "latitude": -12, "label": "120°E"},
          {"longitude": 130, "latitude": -12, "label": "130°E"},
          {"longitude": 140, "latitude": -12, "label": "140°E"},
          {"longitude": 150, "latitude": -12, "label": "150°E"},
          {"longitude": 111, "latitude": -20, "label": "20°S"},
          {"longitude": 111, "latitude": -30, "label": "30°S"},
          {"longitude": 111, "latitude": -40, "label": "40°S"}
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "normal",
        "color": "#526F80",
        "clip": true
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "data": {
        "url": "data/international_states.csv",
        "format": {
          "type": "csv",
          "parse": {
            "value": "number",
            "change_from_2025": "number",
            "percent_change_from_2025": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.period === 'Year ending June 2026' && datum.metric === 'nights_thousand'"
        },
        {
          "calculate": "datum.value - datum.change_from_2025",
          "as": "nights_2025"
        },
        {
          "calculate": "datum.nights_2025 / 1000",
          "as": "nights_2025_million"
        },
        {
          "calculate": "datum.value / 1000",
          "as": "nights_2026_million"
        },
        {
          "calculate": "datum.percent_change_from_2025 / 100",
          "as": "change_fraction"
        },
        {
          "lookup": "state_code",
          "from": {
            "data": {
              "values": [
                {
                  "state_code": "WA",
                  "longitude": 122.3,
                  "latitude": -25.3
                },
                {
                  "state_code": "NT",
                  "longitude": 133.3,
                  "latitude": -20.3
                },
                {
                  "state_code": "SA",
                  "longitude": 134.7,
                  "latitude": -30.4
                },
                {
                  "state_code": "QLD",
                  "longitude": 144.3,
                  "latitude": -23.1
                },
                {
                  "state_code": "NSW",
                  "longitude": 146.4,
                  "latitude": -32.2
                },
                {
                  "state_code": "VIC",
                  "longitude": 144.3,
                  "latitude": -37.1
                },
                {
                  "state_code": "ACT",
                  "longitude": 149.1,
                  "latitude": -35.5,
                  "label_longitude": 155,
                  "label_latitude": -36.9
                },
                {
                  "state_code": "TAS",
                  "longitude": 146.7,
                  "latitude": -42,
                  "label_longitude": 154,
                  "label_latitude": -43.3
                }
              ]
            },
            "key": "state_code",
            "fields": [
              "longitude",
              "latitude",
              "label_longitude",
              "label_latitude"
            ]
          }
        },
        {
          "calculate": "datum.state_code + '\\n' + format(datum.change_fraction, '+.1%')",
          "as": "inside_label"
        },
        {
          "calculate": "datum.state_code + ' ' + format(datum.change_fraction, '+.1%')",
          "as": "outside_label"
        }
      ],
      "layer": [
        {
          "transform": [
            {
              "filter": "datum.state_code !== 'ACT' && datum.state_code !== 'TAS'"
            }
          ],
          "mark": {
            "type": "text",
            "font": "Arial",
            "fontSize": 11,
            "fontWeight": "bold",
            "lineBreak": "\n",
            "lineHeight": 13,
            "align": "center",
            "baseline": "middle",
            "clip": true
          },
          "encoding": {
            "longitude": {
              "field": "longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "latitude",
              "type": "quantitative"
            },
            "text": {
              "field": "inside_label"
            },
            "color": {
              "condition": {
                "test": "datum.percent_change_from_2025 >= 12",
                "value": "white"
              },
              "value": "#202124"
            },
            "tooltip": [
              {
                "field": "state_or_territory",
                "type": "nominal",
                "title": "State or territory"
              },
              {
                "field": "nights_2025_million",
                "type": "quantitative",
                "title": "2025 visitor nights",
                "format": ",.1f"
              },
              {
                "field": "nights_2026_million",
                "type": "quantitative",
                "title": "2026 visitor nights",
                "format": ",.1f"
              },
              {
                "field": "change_fraction",
                "type": "quantitative",
                "title": "Change from 2025",
                "format": "+.1%"
              }
            ]
          }
        },
        {
          "transform": [
            {
              "filter": "datum.state_code === 'ACT' || datum.state_code === 'TAS'"
            }
          ],
          "layer": [
            {
              "mark": {
                "type": "rule",
                "color": "white",
                "strokeWidth": 2.8,
                "clip": true,
                "tooltip": null
              },
              "encoding": {
                "longitude": {
                  "field": "longitude",
                  "type": "quantitative"
                },
                "latitude": {
                  "field": "latitude",
                  "type": "quantitative"
                },
                "longitude2": {
                  "field": "label_longitude"
                },
                "latitude2": {
                  "field": "label_latitude"
                },
                "opacity": {
                  "condition": {
                    "test": "map_zoom <= 1.01 && abs(map_pan_x) < 1 && abs(map_pan_y) < 1",
                    "value": 1
                  },
                  "value": 0
                }
              }
            },
            {
              "mark": {
                "type": "rule",
                "color": "#53606C",
                "strokeWidth": 0.9,
                "clip": true,
                "tooltip": null
              },
              "encoding": {
                "longitude": {
                  "field": "longitude",
                  "type": "quantitative"
                },
                "latitude": {
                  "field": "latitude",
                  "type": "quantitative"
                },
                "longitude2": {
                  "field": "label_longitude"
                },
                "latitude2": {
                  "field": "label_latitude"
                },
                "opacity": {
                  "condition": {
                    "test": "map_zoom <= 1.01 && abs(map_pan_x) < 1 && abs(map_pan_y) < 1",
                    "value": 1
                  },
                  "value": 0
                }
              }
            },
            {
              "mark": {
                "type": "circle",
                "size": 28,
                "color": "#35414C",
                "stroke": "white",
                "strokeWidth": 1,
                "clip": true
              },
              "encoding": {
                "longitude": {
                  "field": "longitude",
                  "type": "quantitative"
                },
                "latitude": {
                  "field": "latitude",
                  "type": "quantitative"
                },
                "opacity": {
                  "condition": {
                    "test": "map_zoom <= 1.01 && abs(map_pan_x) < 1 && abs(map_pan_y) < 1",
                    "value": 1
                  },
                  "value": 0
                },
                "tooltip": [
                  {
                    "field": "state_or_territory",
                    "type": "nominal",
                    "title": "State or territory"
                  },
                  {
                    "field": "nights_2025_million",
                    "type": "quantitative",
                    "title": "2025 visitor nights",
                    "format": ",.1f"
                  },
                  {
                    "field": "nights_2026_million",
                    "type": "quantitative",
                    "title": "2026 visitor nights",
                    "format": ",.1f"
                  },
                  {
                    "field": "change_fraction",
                    "type": "quantitative",
                    "title": "Change from 2025",
                    "format": "+.1%"
                  }
                ]
              }
            },
            {
              "mark": {
                "type": "text",
                "font": "Arial",
                "fontSize": 11,
                "fontWeight": "bold",
                "align": "left",
                "baseline": "middle",
                "dx": 5,
                "color": "#202124",
                "clip": true
              },
              "encoding": {
                "longitude": {
                  "field": "label_longitude",
                  "type": "quantitative"
                },
                "latitude": {
                  "field": "label_latitude",
                  "type": "quantitative"
                },
                "text": {
                  "field": "outside_label"
                },
                "opacity": {
                  "condition": {
                    "test": "map_zoom <= 1.01 && abs(map_pan_x) < 1 && abs(map_pan_y) < 1",
                    "value": 1
                  },
                  "value": 0
                },
                "tooltip": [
                  {
                    "field": "state_or_territory",
                    "type": "nominal",
                    "title": "State or territory"
                  },
                  {
                    "field": "nights_2025_million",
                    "type": "quantitative",
                    "title": "2025 visitor nights",
                    "format": ",.1f"
                  },
                  {
                    "field": "nights_2026_million",
                    "type": "quantitative",
                    "title": "2026 visitor nights",
                    "format": ",.1f"
                  },
                  {
                    "field": "change_fraction",
                    "type": "quantitative",
                    "title": "Change from 2025",
                    "format": "+.1%"
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "config": {
    "background": "white",
    "font": "Arial",
    "view": {"stroke": null},
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "bold",
      "labelColor": "#374151"
    }
  }
}