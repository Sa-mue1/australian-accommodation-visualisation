{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 380,
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  },
  "padding": {
    "left": 5,
    "right": 5,
    "top": 5,
    "bottom": 5
  },
  "title": {
    "text": [
      "International visitor-night growth",
      "varied across states"
    ],
    "subtitle": [
      "Percentage change in international visitor nights",
      "Years ending June 2025 and June 2026"
    ],
    "anchor": "start",
    "fontSize": 18,
    "fontWeight": "bold",
    "lineHeight": 22,
    "subtitleFontSize": 12,
    "subtitleColor": "#5F6368",
    "subtitleLineHeight": 16,
    "subtitlePadding": 7,
    "offset": 14
  },
  "data": {
    "url": "data/international_states.csv",
    "format": {
      "type": "csv",
      "parse": {
        "value": "number",
        "change_from_2025": "number",
        "percent_change_from_2025": "number"
      }
    }
  },
  "params": [
    {
      "name": "map_zoom",
      "value": 1,
      "bind": {
        "input": "range",
        "min": 1,
        "max": 2,
        "step": 0.05,
        "name": "Map zoom: "
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.period === 'Year ending June 2026' && datum.metric === 'nights_thousand'"
    },
    {
      "calculate": "datum.value - datum.change_from_2025",
      "as": "nights_2025"
    },
    {
      "lookup": "state_or_territory",
      "from": {
        "data": {
          "url": "data/geo/australian_states.topojson",
          "format": {
            "type": "topojson",
            "feature": "STE_2021_AUST_GDA2020"
          }
        },
        "key": "properties.STE_NAME21"
      },
      "as": "geo"
    }
  ],
  "projection": {
    "type": "conicEqualArea",
    "parallels": [-18, -36],
    "rotate": [-132, 0, 0],
    "extent": {
      "expr": "[[width / 2 - (width - 20) * map_zoom / 2, height / 2 - (height - 12) * map_zoom / 2], [width / 2 + (width - 20) * map_zoom / 2, height / 2 + (height - 12) * map_zoom / 2]]"
    },
    "clipExtent": {
      "expr": "[[0, 0], [width, height]]"
    }
  },
  "mark": {
    "type": "geoshape",
    "stroke": "white",
    "strokeWidth": 1.2,
    "clip": true
  },
  "encoding": {
    "shape": {
      "field": "geo",
      "type": "geojson"
    },
    "color": {
      "field": "percent_change_from_2025",
      "type": "quantitative",
      "title": "Change from 2025 (%)",
      "scale": {
        "domainMid": 0,
        "scheme": "redblue"
      },
      "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "titleOrient": "top",
        "titleAnchor": "start",
        "gradientLength": {
          "expr": "min(300, width - 20)"
        },
        "gradientThickness": 12,
        "format": "+.0f",
        "tickCount": 5,
        "offset": 12
      }
    },
    "tooltip": [
      {
        "field": "state_or_territory",
        "type": "nominal",
        "title": "State or territory"
      },
      {
        "field": "nights_2025",
        "type": "quantitative",
        "title": "2025 nights ('000)",
        "format": ",.0f"
      },
      {
        "field": "value",
        "type": "quantitative",
        "title": "2026 nights ('000)",
        "format": ",.0f"
      },
      {
        "field": "percent_change_from_2025",
        "type": "quantitative",
        "title": "Change (%)",
        "format": "+.1f"
      }
    ]
  },
  "config": {
    "background": "white",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "bold",
      "labelColor": "#374151"
    }
  }
}