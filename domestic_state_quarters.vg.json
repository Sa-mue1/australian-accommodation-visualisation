{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 224,
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  },
  "padding": {
    "left": 5,
    "right": 5,
    "top": 5,
    "bottom": 5
  },
  "title": {
    "text": "Domestic visitor nights by state and quarter",
    "subtitle": "Quarterly visitor nights in thousands, June 2025-June 2026",
    "anchor": "start",
    "fontSize": 18,
    "fontWeight": "bold",
    "subtitleFontSize": 12,
    "subtitleFontWeight": "normal",
    "subtitlePadding": 7,
    "offset": 8
  },
  "data": {
    "url": "data/domestic_state_quarters.csv",
    "format": {
      "type": "csv",
      "parse": {
        "value": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.metric === 'visitor_nights_thousand' && datum.data_status === 'published' && datum.state_code !== 'AUS'"
    },
    {
      "calculate": "substring(datum.period, 0, 3) + ' ' + substring(datum.period, length(datum.period) - 4)",
      "as": "quarter_label"
    },
    {
      "filter": {
        "field": "quarter_label",
        "oneOf": [
          "Jun 2025",
          "Sep 2025",
          "Dec 2025",
          "Mar 2026",
          "Jun 2026"
        ]
      }
    }
  ],
  "encoding": {
    "x": {
      "field": "quarter_label",
      "type": "ordinal",
      "sort": [
        "Jun 2025",
        "Sep 2025",
        "Dec 2025",
        "Mar 2026",
        "Jun 2026"
      ],
      "scale": {
        "paddingInner": 0,
        "paddingOuter": 0
      },
      "axis": {
        "title": "Quarter ending",
        "labelAngle": 0,
        "labelFontSize": 12,
        "labelFontWeight": "bold",
        "labelPadding": 6,
        "titleFontSize": 13,
        "titleFontWeight": "bold",
        "titlePadding": 8,
        "ticks": false,
        "domain": false
      }
    },
    "y": {
      "field": "state_or_territory",
      "type": "nominal",
      "sort": [
        "New South Wales",
        "Victoria",
        "Queensland",
        "Western Australia",
        "South Australia",
        "Tasmania",
        "Northern Territory",
        "Australian Capital Territory"
      ],
      "scale": {
        "paddingInner": 0,
        "paddingOuter": 0
      },
      "axis": {
        "title": null,
        "labelFontSize": 12,
        "labelFontWeight": "bold",
        "labelLimit": 200,
        "labelPadding": 10,
        "ticks": false,
        "domain": false
      }
    },
    "tooltip": [
      {
        "field": "state_or_territory",
        "type": "nominal",
        "title": "State or territory"
      },
      {
        "field": "period",
        "type": "nominal",
        "title": "Quarter"
      },
      {
        "field": "value",
        "type": "quantitative",
        "title": "Visitor nights",
        "format": ",.1f"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 2,
        "cornerRadius": 2
      },
      "encoding": {
        "color": {
          "field": "value",
          "type": "quantitative",
          "scale": {
            "domain": [0, 34000],
            "range": ["#EDF8F0", "#006D2C"],
            "nice": false
          },
          "legend": {
            "title": "Domestic visitor nights (thousands)",
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 260,
            "gradientThickness": 10,
            "values": [0, 10000, 20000, 34000],
            "format": ",.0f",
            "labelFontSize": 11,
            "titleFontSize": 12,
            "titleFontWeight": "bold",
            "titleLimit": 360,
            "titlePadding": 5,
            "offset": 8
          }
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold",
        "baseline": "middle"
      },
      "encoding": {
        "text": {
          "field": "value",
          "type": "quantitative",
          "format": ",.0f"
        },
        "color": {
          "condition": {
            "test": "datum.value >= 27000",
            "value": "white"
          },
          "value": "#000000"
        }
      }
    }
  ],
  "config": {
    "background": "white",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "grid": false,
      "labelColor": "#374151",
      "titleColor": "#202124"
    }
  }
}