{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 320,
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  },
  "padding": {
    "left": 5,
    "right": 5,
    "top": 5,
    "bottom": 5
  },
  "title": {
    "text": [
      "Queensland had the highest hotel share",
      "among the five largest states"
    ],
    "subtitle": [
      "Domestic visitor nights by accommodation type, 2024",
      "Widths compare recorded nights; night totals are in millions"
    ],
    "anchor": "start",
    "fontSize": 17,
    "fontWeight": "bold",
    "subtitleFontSize": 12,
    "subtitleFontWeight": "normal",
    "subtitlePadding": 7,
    "offset": 8
  },
  "data": {
    "url": "data/domestic_accommodation_types.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "value": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.area_type === 'state_total' && datum.year === 2024 && datum.measure === 'visitor_nights_thousand' && datum.data_status === 'published' && datum.accommodation_type !== 'All accommodation' && indexof(['New South Wales', 'Queensland', 'Victoria', 'Western Australia', 'South Australia'], datum.state_or_territory) >= 0"
    },
    {
      "calculate": "datum.accommodation_type === 'Hotels and similar' ? 'Hotels' : datum.accommodation_type === \"Friends or relatives' property\" ? 'Friends/relatives' : datum.accommodation_type === 'Rented accommodation' ? 'Rented accommodation' : datum.accommodation_type === 'Caravan park or commercial camping' ? 'Caravan/camping' : 'Other/own property'",
      "as": "accommodation_group"
    },
    {
      "calculate": "datum.accommodation_group === 'Hotels' ? 1 : datum.accommodation_group === 'Friends/relatives' ? 2 : datum.accommodation_group === 'Rented accommodation' ? 3 : datum.accommodation_group === 'Caravan/camping' ? 4 : 5",
      "as": "group_order"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "value",
          "as": "visitor_nights_thousand"
        }
      ],
      "groupby": [
        "state_code",
        "state_or_territory",
        "accommodation_group",
        "group_order"
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "visitor_nights_thousand",
          "as": "state_total_thousand"
        }
      ],
      "groupby": ["state_or_territory"]
    },
    {
      "stack": "visitor_nights_thousand",
      "groupby": ["state_or_territory"],
      "sort": [
        {
          "field": "group_order",
          "order": "ascending"
        }
      ],
      "as": ["y0_count", "y1_count"],
      "offset": "zero"
    },
    {
      "calculate": "datum.y0_count / datum.state_total_thousand",
      "as": "y0"
    },
    {
      "calculate": "datum.y1_count / datum.state_total_thousand",
      "as": "y1"
    },
    {
      "calculate": "datum.visitor_nights_thousand / datum.state_total_thousand",
      "as": "accommodation_share"
    },
    {
      "calculate": "datum.visitor_nights_thousand / 1000",
      "as": "visitor_nights_million"
    },
    {
      "calculate": "datum.state_total_thousand / 1000",
      "as": "state_total_million"
    },
    {
      "calculate": "datum.state_or_territory === 'New South Wales' ? 0 : datum.state_or_territory === 'Queensland' ? 0.30946672 : datum.state_or_territory === 'Victoria' ? 0.57784744 : datum.state_or_territory === 'Western Australia' ? 0.79602909 : 0.92995126",
      "as": "x0"
    },
    {
      "calculate": "datum.state_or_territory === 'New South Wales' ? 0.30946672 : datum.state_or_territory === 'Queensland' ? 0.57784744 : datum.state_or_territory === 'Victoria' ? 0.79602909 : datum.state_or_territory === 'Western Australia' ? 0.92995126 : 1",
      "as": "x1"
    },
    {
      "calculate": "(datum.x0 + datum.x1) / 2",
      "as": "x_center"
    },
    {
      "calculate": "(datum.y0 + datum.y1) / 2",
      "as": "y_center"
    },
    {
      "calculate": "format(datum.accommodation_share, '.0%')",
      "as": "share_label"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "x0",
          "type": "quantitative",
          "scale": {
            "domain": [0, 1],
            "nice": false
          },
          "axis": {
            "title": "State (width = recorded nights)",
            "values": [
              0.15473336,
              0.44365708,
              0.68693827,
              0.86299017,
              0.96497563
            ],
            "labelExpr": "datum.value < 0.3 ? 'NSW' : datum.value < 0.56 ? 'QLD' : datum.value < 0.78 ? 'VIC' : datum.value < 0.92 ? 'WA' : 'SA'",
            "labelAngle": 0,
            "labelFontSize": 12,
            "labelFontWeight": "bold",
            "labelPadding": 6,
            "tickSize": 0,
            "domain": false,
            "grid": false,
            "titleFontSize": 13,
            "titleFontWeight": "bold",
            "titlePadding": 8
          }
        },
        "x2": {
          "field": "x1"
        },
        "y": {
          "field": "y0",
          "type": "quantitative",
          "scale": {
            "domain": [0, 1],
            "nice": false
          },
          "axis": {
            "title": "Share of recorded state nights",
            "format": ".0%",
            "values": [0, 0.2, 0.4, 0.6, 0.8, 1],
            "grid": false,
            "labelFontSize": 12,
            "titleFontSize": 13,
            "titleFontWeight": "bold",
            "titlePadding": 12,
            "domain": false,
            "tickSize": 0
          }
        },
        "y2": {
          "field": "y1"
        },
        "color": {
          "field": "accommodation_group",
          "type": "nominal",
          "title": "Accommodation type",
          "sort": [
            "Hotels",
            "Friends/relatives",
            "Rented accommodation",
            "Caravan/camping",
            "Other/own property"
          ],
          "scale": {
            "domain": [
              "Hotels",
              "Friends/relatives",
              "Rented accommodation",
              "Caravan/camping",
              "Other/own property"
            ],
            "range": [
              "#3366A3",
              "#3E454D",
              "#B78118",
              "#A05E93",
              "#B8BDC5"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 3,
            "labelFontSize": 11,
            "labelLimit": 135,
            "titleFontSize": 12,
            "titleFontWeight": "bold",
            "titlePadding": 5,
            "rowPadding": 5,
            "columnPadding": 10,
            "symbolSize": 90,
            "offset": 8
          }
        },
        "tooltip": [
          {
            "field": "state_or_territory",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "accommodation_group",
            "type": "nominal",
            "title": "Accommodation type"
          },
          {
            "field": "visitor_nights_million",
            "type": "quantitative",
            "title": "Visitor nights",
            "format": ",.1f"
          },
          {
            "field": "state_total_million",
            "type": "quantitative",
            "title": "Recorded state nights",
            "format": ",.1f"
          },
          {
            "field": "accommodation_share",
            "type": "quantitative",
            "title": "Share of recorded state nights",
            "format": ".1%"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "fontSize": 12,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "field": "x_center",
          "type": "quantitative",
          "scale": {
            "domain": [0, 1],
            "nice": false
          }
        },
        "y": {
          "field": "y_center",
          "type": "quantitative",
          "scale": {
            "domain": [0, 1],
            "nice": false
          }
        },
        "text": {
          "field": "share_label"
        },
        "color": {
          "condition": {
            "test": "indexof(['Hotels', 'Friends/relatives', 'Caravan/camping'], datum.accommodation_group) >= 0",
            "value": "white"
          },
          "value": "#202124"
        },
        "tooltip": [
          {
            "field": "state_or_territory",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "accommodation_group",
            "type": "nominal",
            "title": "Accommodation type"
          },
          {
            "field": "accommodation_share",
            "type": "quantitative",
            "title": "Share of recorded state nights",
            "format": ".1%"
          }
        ]
      }
    }
  ],
  "config": {
    "background": "white",
    "font": "Arial",
    "view": {
      "stroke": null
    }
  }
}